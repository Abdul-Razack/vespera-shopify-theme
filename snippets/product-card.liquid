{%- comment -%}
  Vespera Theme - Luxury Product Card Snippet
  Accepts:
  - product: {Object} Product Liquid object
  - show_secondary_image: {Boolean} Show secondary image on hover
  - show_vendor: {Boolean} Show product vendor
{%- endcomment -%}

{%- if product and product != empty -%}
  <article class="product-card" aria-labelledby="ProductTitle-{{ product.id }}" data-product-type="{{ product.type | escape }}">
    
    <!-- Product Media Container -->
    <div class="product-card__media-wrapper">
      <a href="{{ product.url }}" class="product-card__media-link" tabindex="-1" aria-hidden="true">
        {%- if product.featured_media != blank -%}
          {%- assign featured_alt = product.featured_media.alt | default: product.title | escape -%}
          {%- capture focal_primary -%}
            {%- if product.featured_media.presentation.focal_point != blank -%}
              object-position: {{ product.featured_media.presentation.focal_point }};
            {%- endif -%}
          {%- endcapture -%}
          {{ product.featured_media | image_url: width: 800 | image_tag:
             loading: 'lazy',
             class: 'product-card__image product-card__image--primary',
             alt: featured_alt,
             style: focal_primary
          }}

          {%- if show_secondary_image != false and product.media[1] != blank -%}
            {%- assign secondary_alt = product.media[1].alt | default: product.title | escape -%}
            {%- capture focal_secondary -%}
              {%- if product.media[1].presentation.focal_point != blank -%}
                object-position: {{ product.media[1].presentation.focal_point }};
              {%- endif -%}
            {%- endcapture -%}
            {{ product.media[1] | image_url: width: 800 | image_tag:
               loading: 'lazy',
               class: 'product-card__image product-card__image--secondary',
               alt: secondary_alt,
               style: focal_secondary
            }}
          {%- endif -%}
        {%- else -%}
          <!-- Clean Placeholder Visual -->
          <div class="product-card__placeholder">
            <svg viewBox="0 0 400 500" fill="none" class="product-card__placeholder-svg" aria-hidden="true">
              <rect width="400" height="500" fill="#F4F1EB"/>
              <circle cx="200" cy="250" r="100" fill="#EAE5DC"/>
              <text x="200" y="255" font-family="serif" font-size="16" fill="#6B6661" text-anchor="middle" letter-spacing="2">VESPERA BOTANICAL</text>
            </svg>
          </div>
        {%- endif -%}
      </a>

      <!-- Product Badges (Sale / Sold Out) -->
      {%- if product.available == false -%}
        <span class="product-card__badge product-card__badge--soldout">
          {{ 'products.product.sold_out' | t | default: 'Sold Out' }}
        </span>
      {%- elsif product.compare_at_price > product.price -%}
        <span class="product-card__badge product-card__badge--sale">
          {{ 'products.product.on_sale' | t | default: 'Sale' }}
        </span>
      {%- endif -%}

      <!-- Quick Actions Container -->
      <div class="product-card__quick-actions">
        <button 
          type="button" 
          class="btn-secondary product-card__quick-btn product-card__quick-btn--view" 
          data-quick-view-handle="{{ product.handle }}" 
          aria-label="{{ 'products.product.quick_view' | t | default: 'Quick View' }}: {{ product.title | escape }}"
        >
          {{ 'products.product.quick_view' | t | default: 'Quick View' }}
        </button>

        {%- if product.available -%}
          {%- if product.has_only_default_variant -%}
            {%- form 'product', product, class: 'product-card__quick-form' -%}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button 
                type="submit" 
                name="add" 
                class="btn-primary product-card__quick-btn product-card__quick-btn--add"
                aria-label="{{ 'products.product.quick_add' | t | default: 'Quick add' }}: {{ product.title | escape }}"
              >
                {{ 'products.product.quick_add' | t | default: 'Quick add' }}
              </button>
            {%- endform -%}
          {%- else -%}
            <button 
              type="button" 
              class="btn-primary product-card__quick-btn product-card__quick-btn--add"
              data-quick-view-handle="{{ product.handle }}"
              aria-label="{{ 'products.product.choose_options' | t | default: 'Choose options' }}: {{ product.title | escape }}"
            >
              {{ 'products.product.choose_options' | t | default: 'Choose options' }}
            </button>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>

    <!-- Product Info Details -->
    <div class="product-card__info">
      {%- if product.type != blank -%}
        <span class="product-card__category">{{ product.type | escape }}</span>
      {%- elsif show_vendor and product.vendor != blank -%}
        <span class="product-card__vendor">{{ product.vendor | escape }}</span>
      {%- endif -%}

      <h3 id="ProductTitle-{{ product.id }}" class="product-card__title">
        <a href="{{ product.url }}" class="product-card__title-link">
          {{ product.title | escape }}
        </a>
      </h3>

      <!-- Price Block (F-22 "From" price) -->
      <div class="product-card__price-wrapper">
        <span class="product-card__price">
          {%- if product.price_varies -%}
            {%- assign formatted_min_price = product.price_min | money -%}
            {{ 'products.product.from_lowest_price_html' | t: price: formatted_min_price }}
          {%- else -%}
            {{ product.price | money }}
          {%- endif -%}
        </span>

        {%- if product.compare_at_price > product.price -%}
          <span class="product-card__price--compare">
            {{ product.compare_at_price | money }}
          </span>
        {%- endif -%}
      </div>

      <!-- Unit Pricing (F-08) -->
      {%- assign first_variant = product.selected_or_first_available_variant -%}
      {%- if first_variant.unit_price_measurement -%}
        <div class="product-card__unit-price">
          <span class="visually-hidden">{{ 'products.product.unit_price_label' | t | default: 'Unit price' }}:</span>
          <span>{{ first_variant.unit_price | money }}</span>
          <span aria-hidden="true">/</span>
          <span>
            {%- if first_variant.unit_price_measurement.reference_value != 1 -%}
              {{- first_variant.unit_price_measurement.reference_value -}}
            {%- endif -%}
            {{ first_variant.unit_price_measurement.reference_unit }}
          </span>
        </div>
      {%- endif -%}
    </div>

  </article>
{%- endif -%}

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    position: relative;
    background-color: transparent;
  }
  .product-card__media-wrapper {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-bg-subtle);
    aspect-ratio: 4 / 5;
    margin-bottom: var(--space-4);
  }
  .product-card__media-link {
    display: block;
    width: 100%;
    height: 100%;
  }
  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-smooth), opacity var(--transition-normal);
  }
  .product-card__image--secondary {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    pointer-events: none;
  }
  .product-card:hover .product-card__image--primary {
    transform: scale(1.03);
  }
  .product-card:hover .product-card__image--secondary {
    opacity: 1;
    transform: scale(1.03);
  }
  .product-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .product-card__placeholder-svg {
    width: 100%;
    height: 100%;
  }
  .product-card__badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    font-size: var(--font-size-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: var(--font-weight-semibold);
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    z-index: 2;
  }
  .product-card__badge--sale {
    background-color: var(--color-surface);
    color: var(--color-sale);
  }
  .product-card__badge--soldout {
    background-color: var(--color-text-muted);
    color: var(--color-surface);
  }
  .product-card__quick-actions {
    position: absolute;
    bottom: var(--space-3);
    left: var(--space-3);
    right: var(--space-3);
    display: flex;
    gap: var(--space-2);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity var(--transition-normal), transform var(--transition-normal);
    z-index: 2;
  }
  .product-card:hover .product-card__quick-actions,
  .product-card:focus-within .product-card__quick-actions {
    opacity: 1;
    transform: translateY(0);
  }
  .product-card__quick-form {
    flex: 1;
    display: flex;
    margin: 0;
  }
  .product-card__quick-btn {
    flex: 1;
    padding: var(--space-2) var(--space-3);
    font-size: var(--font-size-xs);
    letter-spacing: 0.04em;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-subtle);
    white-space: nowrap;
    cursor: pointer;
  }
  .product-card__quick-btn--view {
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }
  .product-card__quick-btn--view:hover {
    background-color: var(--color-text);
    color: var(--color-surface);
  }
  .product-card__quick-btn--add {
    background-color: var(--color-text);
    color: var(--color-surface);
    border: 1px solid var(--color-text);
  }
  .product-card__quick-btn--add:hover {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .product-card__category {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: var(--space-1);
    display: block;
    font-weight: var(--font-weight-medium);
  }
  .product-card__vendor {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
    display: block;
  }
  .product-card__title {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    line-height: 1.4;
    margin-bottom: var(--space-2);
  }
  .product-card__title-link {
    color: var(--color-text);
  }
  .product-card__title-link:hover {
    color: var(--color-accent);
  }
  .product-card__price-wrapper {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .product-card__price {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }
  .product-card__price--compare {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    text-decoration: line-through;
  }
  .product-card__unit-price {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-top: 2px;
  }
  @media (hover: none), (max-width: 768px) {
    .product-card__quick-actions {
      opacity: 1;
      transform: translateY(0);
      bottom: var(--space-2);
      left: var(--space-2);
      right: var(--space-2);
      gap: 4px;
    }
    .product-card__quick-btn {
      height: 40px;
      min-height: 40px;
      font-size: 11px;
      padding: 0 var(--space-2);
    }
  }
  @media (max-width: 430px) {
    .product-card__quick-actions {
      flex-direction: column;
      gap: 4px;
    }
    .product-card__quick-btn {
      width: 100%;
      height: 36px;
      min-height: 36px;
      font-size: 11px;
    }
  }
</style>
