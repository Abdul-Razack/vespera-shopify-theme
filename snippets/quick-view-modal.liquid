<!-- Awwwards-Grade Interactive Quick View Modal Dialog -->
<div class="quick-view-modal" id="QuickViewModal" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'products.product.quick_view' | t | default: 'Quick view' }}">
  <div class="quick-view-modal__overlay" id="QuickViewOverlay" tabindex="-1"></div>
  
  <div class="quick-view-modal__dialog" role="document">
    <button type="button" class="quick-view-modal__close" id="QuickViewClose" aria-label="{{ 'accessibility.close' | t | default: 'Close' }}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="quick-view-modal__body" id="QuickViewBody">
      <div class="quick-view-modal__spinner-wrap">
        <div class="quick-view-modal__spinner"></div>
      </div>
    </div>
  </div>
</div>

<style>
  .quick-view-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 1050;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
  }
  .quick-view-modal[aria-hidden="false"] {
    display: flex;
  }
  .quick-view-modal__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(25, 24, 23, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .quick-view-modal__dialog {
    position: relative;
    background-color: var(--color-surface, #FFFFFF);
    border-radius: var(--radius-sm);
    width: 100%;
    max-width: 860px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 24px 48px rgba(25, 24, 23, 0.2);
    z-index: 2;
    animation: quickViewIn 250ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes quickViewIn {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(12px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }
  .quick-view-modal__close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    cursor: pointer;
    color: var(--color-text);
    z-index: 5;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }
  .quick-view-modal__close:hover {
    background-color: var(--color-text);
    color: var(--color-surface);
  }
  .quick-view-modal__spinner-wrap {
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .quick-view-modal__spinner {
    width: 32px;
    height: 32px;
    border: 2px solid var(--color-border);
    border-top-color: var(--color-accent);
    border-radius: 50%;
    animation: quickViewSpin 600ms linear infinite;
  }
  @keyframes quickViewSpin {
    to { transform: rotate(360deg); }
  }

  /* Quick View Modal Grid Layout */
  .quick-view__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  @media (min-width: 768px) {
    .quick-view__grid {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-8);
      align-items: center;
    }
  }
  .quick-view__media-wrap {
    background-color: var(--color-bg-subtle, #FAF8F5);
    border-radius: var(--radius-sm);
    overflow: hidden;
    position: relative;
    aspect-ratio: 4/5;
  }
  .quick-view__media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .quick-view__info {
    padding: var(--space-6);
  }
  @media (min-width: 768px) {
    .quick-view__info {
      padding: var(--space-8) var(--space-8) var(--space-8) 0;
    }
  }
  .quick-view__category {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    font-weight: var(--font-weight-medium);
    margin-bottom: var(--space-2);
    display: block;
  }
  .quick-view__title {
    font-family: var(--font-heading-family);
    font-size: var(--font-size-xl);
    line-height: 1.25;
    margin-bottom: var(--space-3);
    color: var(--color-text);
  }
  .quick-view__title-link {
    color: inherit;
    text-decoration: none;
  }
  .quick-view__title-link:hover {
    color: var(--color-accent);
  }
  .quick-view__prices {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .quick-view__price {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }
  .quick-view__compare-price {
    font-size: var(--font-size-sm);
    text-decoration: line-through;
    color: var(--color-text-muted);
  }
  .quick-view__desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }
  .quick-view__options {
    margin-bottom: var(--space-6);
  }
  .quick-view__option-title {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--space-2);
  }
  .quick-view__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .quick-view__chip-btn {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: transparent;
    font-size: var(--font-size-xs);
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .quick-view__chip-btn.is-selected {
    background-color: var(--color-text);
    color: var(--color-surface);
    border-color: var(--color-text);
  }
  .quick-view__cta-row {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .quick-view__qty-wrap {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    height: 48px;
  }
  .quick-view__qty-btn {
    width: 36px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 16px;
    color: var(--color-text);
  }
  .quick-view__qty-val {
    width: 32px;
    text-align: center;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }
  .quick-view__add-btn {
    flex: 1;
    height: 48px;
    font-size: var(--font-size-sm);
  }
  .quick-view__full-details {
    display: inline-block;
    font-size: var(--font-size-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: underline;
    transition: color var(--transition-fast);
  }
  .quick-view__full-details:hover {
    color: var(--color-accent);
  }
</style>
