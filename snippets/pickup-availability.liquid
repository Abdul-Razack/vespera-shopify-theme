{%- comment -%}
  Vespera Theme - Local Pickup Availability Snippet (F-17)
  Complies with Shopify Section 4: Store availability for local pickup.
{%- endcomment -%}

<div class="product-pickup-availability" data-pickup-availability-container data-base-url="{{ shop.url }}{{ routes.root_url }}">
  {%- assign pick_up_availabilities = current_variant.store_availabilities | where: 'pick_up_enabled', true -%}
  {%- if pick_up_availabilities.size > 0 -%}
    <div class="pickup-availability-information">
      <div class="pickup-availability-header">
        <span class="pickup-availability-icon" aria-hidden="true">&#10003;</span>
        <div class="pickup-availability-content">
          <p class="pickup-availability-title">
            {{ 'products.product.pickup_available_at_html' | t: location_name: pick_up_availabilities.first.location.name | default: 'Pickup available at ' | append: pick_up_availabilities.first.location.name }}
          </p>
          <p class="pickup-availability-time">
            {{ pick_up_availabilities.first.pick_up_time }}
          </p>
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

