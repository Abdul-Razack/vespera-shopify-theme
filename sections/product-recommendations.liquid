{%- comment -%}
  Vespera Theme - Product Recommendations Section (Online Store 2.0)
  Supports both 'related' and 'complementary' recommendation intents (F-18).
  Dynamically loads recommendations via Shopify Recommendations API.
{%- endcomment -%}

<div 
  class="product-recommendations page-container section-spacing"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent={{ section.settings.intent }}"
  data-section-id="{{ section.id }}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <header class="section-header text-center">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2 class="section-title">
        {{ section.settings.heading | escape }}
      </h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="section-subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </header>

    <div class="product-grid product-grid--{{ section.settings.columns_desktop }}-col">
      {%- for recommendation in recommendations.products -%}
        <div class="product-grid__item">
          {% render 'product-card', product: recommendation, card_heading_level: 'h3' %}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<script>
  (function() {
    const handleIntersection = (entries, observer) => {
      if (!entries[0].isIntersecting) return;
      observer.unobserve(productRecommendationsSection);

      const url = productRecommendationsSection.dataset.url;
      fetch(url)
        .then(response => response.text())
        .then(text => {
          const html = document.createElement('div');
          html.innerHTML = text;
          const recommendations = html.querySelector('.product-recommendations');

          if (recommendations && recommendations.innerHTML.trim().length) {
            productRecommendationsSection.innerHTML = recommendations.innerHTML;
          }
        })
        .catch(e => {
          console.error(e);
        });
    };

    const productRecommendationsSection = document.querySelector('.product-recommendations[data-section-id="{{ section.id }}"]');
    if (productRecommendationsSection) {
      const observer = new IntersectionObserver(handleIntersection, { rootMargin: '0px 0px 400px 0px' });
      observer.observe(productRecommendationsSection);
    }
  })();
</script>

{% schema %}
{
  "name": "Product recommendations",
  "tag": "section",
  "class": "section-product-recommendations",
  "settings": [
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation intent",
      "options": [
        {
          "value": "related",
          "label": "Related products"
        },
        {
          "value": "complementary",
          "label": "Complementary products (pairs with)"
        }
      ],
      "default": "related"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CURATED PAIRINGS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complete your botanical ritual"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Formulations designed to amplify cellular hydration and barrier radiance."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Maximum products to show",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ],
      "default": "4"
    }
  ],
  "presets": [
    {
      "name": "Product recommendations",
      "settings": {
        "intent": "related",
        "heading": "Complete your botanical ritual"
      }
    }
  ]
}
{% endschema %}
