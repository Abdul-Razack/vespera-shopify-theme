{%- comment -%}
  Vespera Theme - Main Product Section (Online Store 2.0)
  Modular, reorderable block architecture supporting @app blocks, Custom Liquid,
  rich media (3D/video), unit pricing, selling plans, pickup availability, and sticky buy dock.
{%- endcomment -%}

<script src="{{ 'variant-picker.js' | asset_url }}" defer="defer"></script>

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign featured_media = current_variant.featured_media | default: product.featured_media -%}

<div 
  class="main-product page-container section-spacing" 
  data-section-id="{{ section.id }}" 
  data-product-id="{{ product.id }}"
  data-variant-picker-container
  data-update-url="true"
>
  <div class="main-product__layout">
    
    <!-- LEFT COLUMN: Rich Media Gallery -->
    <div class="main-product__media-col">
      {% render 'product-media-gallery', 
        product: product, 
        section_id: section.id, 
        featured_media: featured_media,
        enable_zoom: true 
      %}
    </div>

    <!-- RIGHT COLUMN: Modular Reorderable Product Info Stack -->
    <div class="main-product__info-col">
      <div class="main-product__info-stack">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            
            {%- when '@app' -%}
              <div class="main-product__app-block" {{ block.shopify_attributes }}>
                {% render block %}
              </div>

            {%- when 'vendor' -%}
              <p class="main-product__vendor" {{ block.shopify_attributes }}>
                {%- if block.settings.show_vendor and product.vendor != blank -%}
                  {{ product.vendor | escape }} &bull; {{ 'products.product.clinical_grade' | t }}
                {%- else -%}
                  VESPERA &bull; {{ 'products.product.clinical_grade' | t }}
                {%- endif -%}
              </p>

            {%- when 'title' -%}
              <div class="main-product__title-wrap" {{ block.shopify_attributes }}>
                <h1 class="main-product__title">{{ product.title | escape }}</h1>
              </div>

            {%- when 'price' -%}
              <div class="main-product__price-wrap" id="Price-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
                <span class="main-product__price" data-regular-price>{{ current_variant.price | money }}</span>
                
                <span 
                  class="main-product__compare-price" 
                  data-compare-price 
                  {% unless current_variant.compare_at_price > current_variant.price %}style="display: none;"{% endunless %}
                >
                  {{ current_variant.compare_at_price | money }}
                </span>

                <!-- Unit Pricing (Legal mandate - F-08) -->
                <div 
                  class="main-product__unit-price" 
                  data-unit-price-wrapper
                  {% unless current_variant.unit_price_measurement %}style="display: none;"{% endunless %}
                >
                  <span class="visually-hidden">{{ 'products.product.unit_price_label' | t }}:</span>
                  <span data-unit-price>{{ current_variant.unit_price | money }}</span>
                  <span aria-hidden="true">/</span>
                  <span data-unit-price-base>
                    {%- if current_variant.unit_price_measurement.reference_value != 1 -%}
                      {{- current_variant.unit_price_measurement.reference_value -}}
                    {%- endif -%}
                    {{ current_variant.unit_price_measurement.reference_unit }}
                  </span>
                </div>

                <!-- Tax & Shipping Policy Notice (F-21) -->
                {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                  <span class="main-product__tax-note">
                    {%- if cart.taxes_included -%}
                      {{ 'products.product.include_taxes' | t }}
                    {%- endif -%}
                    {%- if shop.shipping_policy.body != blank -%}
                      {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                    {%- endif -%}
                  </span>
                {%- endif -%}

                <!-- Stock / Inventory State Notice (F-32) -->
                <div class="main-product__stock-status">
                  {%- if current_variant.available and current_variant.inventory_policy == 'continue' and current_variant.inventory_quantity <= 0 -%}
                    <span class="stock-dot stock-dot--backorder" data-stock-dot></span>
                    <span class="stock-text" data-stock-text>{{ 'products.product.backorder_message' | t }}</span>
                  {%- elsif current_variant.available -%}
                    <span class="stock-dot stock-dot--in" data-stock-dot></span>
                    <span class="stock-text" data-stock-text>{{ 'products.product.in_stock' | t }}</span>
                  {%- else -%}
                    <span class="stock-dot stock-dot--out" data-stock-dot></span>
                    <span class="stock-text" data-stock-text>{{ 'products.product.sold_out' | t }}</span>
                  {%- endif -%}
                </div>
              </div>

            {%- when 'variant_picker' -%}
              <div class="main-product__variant-picker-wrap" {{ block.shopify_attributes }}>
                {% render 'product-variant-picker', 
                  product: product, 
                  section_id: section.id 
                %}
              </div>

            {%- when 'quantity' -%}
              <div class="main-product__qty-group" {{ block.shopify_attributes }}>
                <label for="Quantity-{{ section.id }}" class="main-product__qty-label">
                  {{ 'products.product.quantity' | t }}
                </label>
                <div class="main-product__qty-stepper">
                  <button type="button" class="main-product__qty-btn" data-product-qty-minus aria-label="{{ 'products.product.decrease_quantity' | t }}">&minus;</button>
                  <input 
                    type="number" 
                    id="Quantity-{{ section.id }}" 
                    name="quantity" 
                    value="1" 
                    min="1" 
                    class="main-product__qty-input"
                    data-product-qty-input
                    form="ProductForm-{{ section.id }}"
                  >
                  <button type="button" class="main-product__qty-btn" data-product-qty-plus aria-label="{{ 'products.product.increase_quantity' | t }}">&plus;</button>
                </div>
              </div>

            {%- when 'buy_buttons' -%}
              <div class="main-product__buy-buttons-wrap" {{ block.shopify_attributes }}>
                {% render 'product-buy-buttons', 
                  product: product, 
                  section_id: section.id, 
                  show_dynamic_checkout: block.settings.show_dynamic_checkout,
                  show_gift_card_recipient: block.settings.show_gift_card_recipient,
                  block_attributes: block.shopify_attributes 
                %}
              </div>

            {%- when 'pickup_availability' -%}
              <div class="main-product__pickup-wrap" {{ block.shopify_attributes }}>
                {% render 'pickup-availability', current_variant: current_variant %}
              </div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="main-product__description rte" {{ block.shopify_attributes }}>
                  {{ product.description }}
                </div>
              {%- endif -%}

            {%- when 'custom_liquid' -%}
              <div class="main-product__custom-liquid" {{ block.shopify_attributes }}>
                {{ block.settings.custom_liquid }}
              </div>

            {%- when 'clinical_study' -%}
              <details class="main-product__accordion" {{ block.shopify_attributes }}>
                <summary class="main-product__accordion-summary">
                  <div class="main-product__accordion-header-wrap">
                    <span class="main-product__accordion-title">{{ block.settings.heading | escape }}</span>
                    {%- if block.settings.metric != blank -%}
                      <span class="clinical-metric-badge">{{ block.settings.metric | escape }}</span>
                    {%- endif -%}
                  </div>
                  <span class="accordion-icon" aria-hidden="true">+</span>
                </summary>
                <div class="main-product__accordion-content">
                  {%- if block.settings.summary != blank -%}
                    <p class="clinical-study-summary"><strong>{{ block.settings.summary | escape }}</strong></p>
                  {%- endif -%}
                  <div class="rte">{{ block.settings.content }}</div>
                </div>
              </details>

            {%- when 'ingredients' -%}
              <details class="main-product__accordion" {{ block.shopify_attributes }}>
                <summary class="main-product__accordion-summary">
                  <div class="main-product__accordion-header-wrap">
                    <span class="main-product__accordion-title">{{ block.settings.heading | escape }}</span>
                    {%- if block.settings.bioactives_count != blank -%}
                      <span class="clinical-metric-badge">{{ block.settings.bioactives_count | escape }}</span>
                    {%- endif -%}
                  </div>
                  <span class="accordion-icon" aria-hidden="true">+</span>
                </summary>
                <div class="main-product__accordion-content">
                  {%- if block.settings.key_bioactives != blank -%}
                    <div class="clinical-bioactives-list">
                      <span class="clinical-bioactives-label">{{ 'products.product.key_bio_actives' | t }}</span>
                      <span class="clinical-bioactives-text">{{ block.settings.key_bioactives | escape }}</span>
                    </div>
                  {%- endif -%}
                  <div class="rte">{{ block.settings.content }}</div>
                </div>
              </details>

            {%- when 'ritual' -%}
              <details class="main-product__accordion" {{ block.shopify_attributes }}>
                <summary class="main-product__accordion-summary">
                  <div class="main-product__accordion-header-wrap">
                    <span class="main-product__accordion-title">{{ block.settings.heading | escape }}</span>
                  </div>
                  <span class="accordion-icon" aria-hidden="true">+</span>
                </summary>
                <div class="main-product__accordion-content">
                  <div class="rte">{{ block.settings.content }}</div>
                </div>
              </details>

            {%- when 'collapsible_tab' -%}
              <details class="main-product__accordion" {{ block.shopify_attributes }}>
                <summary class="main-product__accordion-summary">
                  <span class="main-product__accordion-title">{{ block.settings.heading | escape }}</span>
                  <span class="accordion-icon" aria-hidden="true">+</span>
                </summary>
                <div class="main-product__accordion-content">
                  <div class="rte">
                    {{ block.settings.content }}
                    {{ block.settings.page.content }}
                  </div>
                </div>
              </details>

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>

  </div>
</div>

<!-- Universal Bottom Sticky Buy Bar -->
<div class="sticky-buy-dock" id="StickyBuyDock" inert>
  <div class="sticky-buy-dock__inner page-container">
    <div class="sticky-buy-dock__product">
      {%- if featured_media != blank -%}
        <img 
          src="{{ featured_media | image_url: width: 120, height: 120, crop: 'center' }}" 
          alt="{{ product.title | escape }}" 
          width="48" 
          height="48" 
          class="sticky-buy-dock__img"
          loading="lazy"
          id="StickyBuyDockImg"
        >
      {%- endif -%}
      <div class="sticky-buy-dock__text">
        <span class="sticky-buy-dock__category">{{ product.type }}</span>
        <p class="sticky-buy-dock__title">{{ product.title | escape }}</p>
      </div>
    </div>

    <div class="sticky-buy-dock__center">
      {%- unless product.has_only_default_variant -%}
        <div class="sticky-buy-dock__select-wrap">
          <select class="sticky-buy-dock__select" id="StickyVariantSelect" aria-label="{{ 'products.product.select_variant' | t }}">
            {%- for variant in product.variants -%}
              <option 
                value="{{ variant.id }}"
                {% if variant == current_variant %}selected="selected"{% endif %}
                {% unless variant.available %}disabled="disabled"{% endunless %}
              >
                {{ variant.title }} &bull; {{ variant.price | money }} {%- unless variant.available %} ({{ 'products.product.sold_out' | t }}){%- endunless -%}
              </option>
            {%- endfor -%}
          </select>
        </div>
      {%- endunless -%}
      <div class="sticky-buy-dock__price" id="StickyBuyDockPrice">
        {{ current_variant.price | money }}
      </div>
    </div>

    <div class="sticky-buy-dock__actions">
      <div class="sticky-buy-dock__qty">
        <button type="button" class="sticky-buy-dock__qty-btn" id="StickyQtyMinus" aria-label="{{ 'products.product.decrease_quantity' | t }}">&minus;</button>
        <span class="sticky-buy-dock__qty-val" id="StickyQtyVal">1</span>
        <button type="button" class="sticky-buy-dock__qty-btn" id="StickyQtyPlus" aria-label="{{ 'products.product.increase_quantity' | t }}">&plus;</button>
      </div>

      <button 
        type="button" 
        class="btn-primary sticky-buy-dock__btn" 
        id="StickyBuyBtn"
        {% unless current_variant.available %}disabled="disabled"{% endunless %}
      >
        {%- if current_variant.available -%}
          {{ 'products.product.add_to_cart' | t }}
        {%- else -%}
          {{ 'products.product.sold_out' | t }}
        {%- endif -%}
      </button>
    </div>
  </div>
</div>

<!-- Fullscreen Lightbox Zoom Modal -->
<div id="ProductZoomModal-{{ section.id }}" class="product-zoom-modal" role="dialog" aria-modal="true" aria-label="{{ product.title | escape }} Image Lightbox" aria-hidden="true">
  <div class="product-zoom-modal__backdrop" data-zoom-close></div>
  <div class="product-zoom-modal__container">
    <header class="product-zoom-modal__header">
      <span class="product-zoom-modal__counter" id="ProductZoomCounter-{{ section.id }}">1 / {{ product.media.size | default: 1 | at_least: 1 }}</span>
      <span class="product-zoom-modal__title">{{ product.title | escape }}</span>
      <button type="button" class="product-zoom-modal__close-btn" data-zoom-close aria-label="Close image zoom (Esc)">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>

    <div class="product-zoom-modal__stage">
      {%- if product.media.size > 1 -%}
        <button type="button" class="product-zoom-modal__arrow product-zoom-modal__arrow--prev" id="ProductZoomPrev-{{ section.id }}" aria-label="Previous image">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
      {%- endif -%}

      <div class="product-zoom-modal__viewport" id="ProductZoomViewport-{{ section.id }}">
        <img 
          id="ProductZoomImg-{{ section.id }}"
          src="{{ featured_media | image_url: width: 2400 }}" 
          alt="{{ featured_media.alt | default: product.title | escape }}"
          class="product-zoom-modal__img"
          width="{{ featured_media.width | default: 1800 }}"
          height="{{ featured_media.height | default: 2200 }}"
          loading="eager"
        >
      </div>

      {%- if product.media.size > 1 -%}
        <button type="button" class="product-zoom-modal__arrow product-zoom-modal__arrow--next" id="ProductZoomNext-{{ section.id }}" aria-label="Next image">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      {%- endif -%}
    </div>
  </div>
</div>

<!-- Safe JSON Media Data for Zoom Controller -->
<script type="application/json" id="ProductMediaJson-{{ section.id }}">
  [
    {%- if product.media.size > 0 -%}
      {%- for media in product.media -%}
        {
          "id": {{ media.id }},
          "src": {{ media | image_url: width: 2400 | json }},
          "alt": {{ media.alt | default: product.title | escape | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    {%- elsif featured_media != blank -%}
      {
        "id": 0,
        "src": {{ featured_media | image_url: width: 2400 | json }},
        "alt": {{ product.title | escape | json }}
      }
    {%- endif -%}
  ]
</script>

<!-- Safe JSON Variant Data for Controller -->
<script type="application/json" data-product-variants-json id="ProductJson-{{ section.id }}">
  {{ product.variants | json }}
</script>

<script>
  (function() {
    const section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;

    // Media Gallery and Lightbox Controller
    const gallery = section.querySelector('[data-gallery]');
    const zoomModal = document.getElementById('ProductZoomModal-{{ section.id }}');
    const zoomTrigger = section.querySelector('.product-media-gallery__zoom-trigger');
    const zoomImg = document.getElementById('ProductZoomImg-{{ section.id }}');
    const zoomCounter = document.getElementById('ProductZoomCounter-{{ section.id }}');
    const zoomPrev = document.getElementById('ProductZoomPrev-{{ section.id }}');
    const zoomNext = document.getElementById('ProductZoomNext-{{ section.id }}');
    const zoomViewport = document.getElementById('ProductZoomViewport-{{ section.id }}');
    let mediaData = [];
    try {
      const mediaEl = document.getElementById('ProductMediaJson-{{ section.id }}');
      if (mediaEl) mediaData = JSON.parse(mediaEl.textContent);
    } catch(e) {}

    let currentMediaIndex = 0;

    function setMedia(index) {
      if (!mediaData || !mediaData.length) return;
      currentMediaIndex = (index + mediaData.length) % mediaData.length;
      const media = mediaData[currentMediaIndex];
      if (!media) return;

      const featuredImg = section.querySelector('[data-featured-image]');
      if (featuredImg && media.src) {
        featuredImg.src = media.src;
        if (media.alt) featuredImg.alt = media.alt;
      }

      const thumbs = section.querySelectorAll('.product-media-gallery__thumb-btn');
      thumbs.forEach((thumb, i) => {
        if (i === currentMediaIndex) {
          thumb.classList.add('is-active');
          thumb.setAttribute('aria-current', 'true');
        } else {
          thumb.classList.remove('is-active');
          thumb.removeAttribute('aria-current');
        }
      });

      if (zoomImg && media.src) {
        zoomImg.src = media.src;
        if (media.alt) zoomImg.alt = media.alt;
      }
      if (zoomCounter) {
        zoomCounter.textContent = `${currentMediaIndex + 1} / ${mediaData.length}`;
      }
    }

    if (gallery) {
      gallery.addEventListener('click', (e) => {
        const thumb = e.target.closest('.product-media-gallery__thumb-btn');
        if (!thumb) return;
        const idx = parseInt(thumb.getAttribute('data-media-index'), 10);
        if (!isNaN(idx)) setMedia(idx);
      });
    }

    if (zoomTrigger && zoomModal) {
      const openZoom = () => {
        zoomModal.setAttribute('aria-hidden', 'false');
        zoomModal.classList.add('is-open');
        document.body.style.overflow = 'hidden';
        setMedia(currentMediaIndex);
        const closeBtn = zoomModal.querySelector('[data-zoom-close]');
        if (closeBtn) closeBtn.focus();
      };

      const closeZoom = () => {
        zoomModal.setAttribute('aria-hidden', 'true');
        zoomModal.classList.remove('is-open');
        if (zoomViewport) zoomViewport.classList.remove('is-magnified');
        document.body.style.overflow = '';
        zoomTrigger.focus();
      };

      zoomTrigger.addEventListener('click', openZoom);

      zoomModal.querySelectorAll('[data-zoom-close]').forEach(btn => {
        btn.addEventListener('click', closeZoom);
      });

      if (zoomPrev) zoomPrev.addEventListener('click', (e) => { e.stopPropagation(); setMedia(currentMediaIndex - 1); });
      if (zoomNext) zoomNext.addEventListener('click', (e) => { e.stopPropagation(); setMedia(currentMediaIndex + 1); });

      if (zoomViewport) {
        zoomViewport.addEventListener('click', () => {
          zoomViewport.classList.toggle('is-magnified');
        });
      }

      window.addEventListener('keydown', (e) => {
        if (zoomModal.getAttribute('aria-hidden') === 'false') {
          if (e.key === 'Escape') closeZoom();
          if (e.key === 'ArrowLeft') setMedia(currentMediaIndex - 1);
          if (e.key === 'ArrowRight') setMedia(currentMediaIndex + 1);
        }
      });
    }

    // Sticky Buy Dock Synchronizer
    const stickyDock = document.getElementById('StickyBuyDock');
    const stickySelect = document.getElementById('StickyVariantSelect');
    const stickyPrice = document.getElementById('StickyBuyDockPrice');
    const stickyImg = document.getElementById('StickyBuyDockImg');
    const stickyBtn = document.getElementById('StickyBuyBtn');
    const stickyQtyMinus = document.getElementById('StickyQtyMinus');
    const stickyQtyPlus = document.getElementById('StickyQtyPlus');
    const stickyQtyVal = document.getElementById('StickyQtyVal');
    const addBtn = section.querySelector('[data-add-to-cart-btn]') || section.querySelector('button[name="add"]');
    const qtyInput = section.querySelector('[data-product-qty-input]');

    section.addEventListener('vespera:variant:change', (e) => {
      const { variant, formattedPrice } = e.detail;
      if (stickySelect && variant) stickySelect.value = variant.id;
      if (stickyPrice) stickyPrice.textContent = formattedPrice;
      if (stickyBtn) {
        if (variant && variant.available) {
          stickyBtn.removeAttribute('disabled');
          stickyBtn.textContent = 'Add to cart';
        } else {
          stickyBtn.setAttribute('disabled', 'disabled');
          stickyBtn.textContent = 'Sold out';
        }
      }
      if (stickyImg && variant && variant.featured_image) {
        stickyImg.src = variant.featured_image.src;
      }
    });

    if (stickySelect) {
      stickySelect.addEventListener('change', () => {
        const targetId = parseInt(stickySelect.value, 10);
        const radio = section.querySelector(`input[name="id"][value="${targetId}"]`);
        if (radio) {
          radio.checked = true;
          radio.dispatchEvent(new Event('change'));
        }
      });
    }

    if (stickyBtn && addBtn) {
      stickyBtn.addEventListener('click', () => addBtn.click());
    }

    function setQuantity(val) {
      const clamped = Math.max(1, parseInt(val, 10) || 1);
      if (qtyInput) qtyInput.value = clamped;
      if (stickyQtyVal) stickyQtyVal.textContent = clamped;
    }

    const minusBtn = section.querySelector('[data-product-qty-minus]');
    const plusBtn = section.querySelector('[data-product-qty-plus]');
    if (minusBtn && plusBtn && qtyInput) {
      minusBtn.addEventListener('click', () => setQuantity((parseInt(qtyInput.value, 10) || 1) - 1));
      plusBtn.addEventListener('click', () => setQuantity((parseInt(qtyInput.value, 10) || 1) + 1));
      qtyInput.addEventListener('change', () => setQuantity(qtyInput.value));
    }
    if (stickyQtyMinus && stickyQtyPlus) {
      stickyQtyMinus.addEventListener('click', () => setQuantity((parseInt(qtyInput ? qtyInput.value : 1, 10) || 1) - 1));
      stickyQtyPlus.addEventListener('click', () => setQuantity((parseInt(qtyInput ? qtyInput.value : 1, 10) || 1) + 1));
    }

    // Scroll Observer and Keyboard Handler for Sticky Dock
    if (stickyDock && addBtn) {
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
              stickyDock.removeAttribute('inert');
              stickyDock.classList.add('is-visible');
            } else {
              if (document.activeElement && stickyDock.contains(document.activeElement)) {
                addBtn.focus();
              }
              stickyDock.setAttribute('inert', '');
              stickyDock.classList.remove('is-visible');
            }
          });
        }, { threshold: 0 });
        observer.observe(addBtn);
      }

      stickyDock.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          if (document.activeElement && stickyDock.contains(document.activeElement)) {
            addBtn.focus();
          }
          stickyDock.setAttribute('inert', '');
          stickyDock.classList.remove('is-visible');
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "class": "section-main-product",
  "settings": [],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_vendor",
          "label": "Show brand vendor",
          "default": true
        }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1
    },
    {
      "type": "quantity",
      "name": "Quantity selector",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout button",
