{%- paginate collection.products by section.settings.products_per_page -%}
  <div class="main-collection page-container section-spacing">
    
    <!-- Collection Banner & Header -->
    <header class="main-collection__header">
      <div class="main-collection__header-content">
        <h1 class="main-collection__title">{{ collection.title | escape }}</h1>
        
        {%- if collection.description != blank -%}
          <div class="main-collection__description">
            {{ collection.description }}
          </div>
        {%- endif -%}
      </div>

      <!-- Category Navigation Pills -->
      {%- if section.settings.show_category_pills and collection.all_types.size > 1 -%}
        {%- assign is_all_active = false -%}
        {%- if collection.current_type == blank -%}
          {%- assign is_all_active = true -%}
        {%- endif -%}
        <nav class="category-pills" aria-label="{{ 'sections.collection_template.filter_by_category' | t }}">
          <ul class="category-pills__list" role="list">
            <li>
              <a 
                href="{{ routes.all_products_collection_url }}" 
                class="category-pill{% if is_all_active %} category-pill--active{% endif %}" 
                {% if is_all_active %}aria-current="page"{% endif %}
                data-category-all
              >
                {{ 'collections.general.all_products' | t }} <span class="category-pill__count">({{ collection.all_products_count | default: collection.products_count }})</span>
              </a>
            </li>
            {%- for type in collection.all_types -%}
              {%- if type != blank -%}
                {%- assign is_type_active = false -%}
                {%- if collection.current_type == type -%}
                  {%- assign is_type_active = true -%}
                {%- endif -%}
                <li>
                  <a 
                    href="{{ routes.collections_url }}/types?q={{ type | url_encode }}" 
                    class="category-pill{% if is_type_active %} category-pill--active{% endif %}" 
                    {% if is_type_active %}aria-current="page"{% endif %}
                    data-category-type="{{ type | escape }}"
                  >
                    {{ type | escape }}
                    {%- if is_type_active -%}
                      <span class="category-pill__count">({{ paginate.items }})</span>
                    {%- endif -%}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      <!-- Storefront Faceted Filtering & Sorting -->
      {% render 'facets', results: collection, enable_filtering: section.settings.enable_filtering, enable_sorting: section.settings.enable_sorting %}
    </header>

    <!-- Product Grid -->
    <div class="product-grid product-grid--{{ section.settings.columns_desktop }}-col">
      {%- for product in collection.products -%}
        <div class="product-grid__item">
          {% render 'product-card', 
             product: product, 
             show_secondary_image: section.settings.show_secondary_image, 
             show_vendor: section.settings.show_vendor 
          %}
        </div>
      {%- else -%}
        <div class="main-collection__empty">
          <p>{{ 'collections.general.no_matches' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn-primary" style="margin-top: var(--space-4);">
            {{ 'collections.general.view_all_products' | t }}
          </a>
        </div>
      {%- endfor -%}
    </div>

    <!-- Pagination -->
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
        <ul class="pagination__list" role="list">
          {%- if paginate.previous -%}
            <li>
              <a href="{{ paginate.previous.url }}" class="pagination__item pagination__item--prev" aria-label="{{ 'general.pagination.previous' | t }}">
                &larr;
              </a>
            </li>
          {%- endif -%}

          {%- for part in paginate.parts -%}
            <li>
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="pagination__item" aria-label="{{ 'general.pagination.page' | t: number: part.title | default: part.title }}">
                  {{ part.title }}
                </a>
              {%- else -%}
                {%- if part.title == paginate.current_page -%}
                  <span class="pagination__item pagination__item--current" aria-current="page">
                    {{ part.title }}
                  </span>
                {%- else -%}
                  <span class="pagination__item pagination__item--gap">&hellip;</span>
                {%- endif -%}
              {%- endif -%}
            </li>
          {%- endfor -%}

          {%- if paginate.next -%}
            <li>
              <a href="{{ paginate.next.url }}" class="pagination__item pagination__item--next" aria-label="{{ 'general.pagination.next' | t }}">
                &rarr;
              </a>
            </li>
          {%- endif -%}
        </ul>
      </nav>
    {%- endif -%}

  </div>
{%- endpaginate -%}

<style>
  .main-collection__header {
    margin-bottom: var(--space-8);
  }
  .main-collection__title {
    margin-bottom: var(--space-3);
  }
  .main-collection__description {
    font-size: var(--font-size-md);
    color: var(--color-text-muted);
    max-width: 680px;
    margin-bottom: var(--space-6);
  }
  .main-collection__toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-4);
  }
  .main-collection__count {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
  .main-collection__sort-select {
    font-size: var(--font-size-sm);
    color: var(--color-text);
    background: transparent;
    border: 1px solid var(--color-border-dark);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    outline: none;
    cursor: pointer;
  }
  
  /* The Responsive Product Grid */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  @media (max-width: 480px) {
    .product-grid {
      gap: var(--space-3);
    }
  }
  @media (min-width: 768px) {
    .product-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
    }
  }
  @media (min-width: 1200px) {
    .product-grid--4-col {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .main-collection__empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: var(--space-20) 0;
    color: var(--color-text-muted);
  }

  /* Category Navigation Pills */
  .category-pills {
    margin-top: var(--space-4);
    margin-bottom: var(--space-4);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 4px;
  }
  .category-pills::-webkit-scrollbar {
    display: none;
  }
  .category-pills__list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: nowrap;
  }
  @media (min-width: 990px) {
    .category-pills__list {
      flex-wrap: wrap;
    }
  }
  .category-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    min-height: 44px;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text);
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--transition-fast);
    white-space: nowrap;
    text-decoration: none;
    user-select: none;
  }
  .category-pill:hover {
    color: var(--color-text);
    border-color: var(--color-border-dark);
  }
  .category-pill--active,
  .category-pill[aria-current="page"],
  .category-pill[aria-pressed="true"] {
    color: var(--color-surface);
    background-color: var(--color-text);
    border-color: var(--color-text);
  }
  .category-pill__count {
    font-size: 11px;
    color: var(--color-text);
    font-weight: 500;
    opacity: 1;
  }
  .category-pill--active .category-pill__count,
  .category-pill[aria-current="page"] .category-pill__count,
  .category-pill[aria-pressed="true"] .category-pill__count {
    color: var(--color-surface);
    opacity: 1;
  }
</style>

<script>
  (function() {
    // Legacy /card URL query migration (?category=...) to Shopify native /collections/types?q=
    const params = new URLSearchParams(window.location.search);
    const categoryParam = params.get('category');
    if (!categoryParam) return;

    if (categoryParam.toLowerCase() === 'all') {
      const cleanUrl = new URL(window.location.href);
      cleanUrl.searchParams.delete('category');
      window.location.replace(cleanUrl.toString());
      return;
    }

    const pills = document.querySelectorAll('[data-category-type]');
    const rawReq = decodeURIComponent(categoryParam).trim().toLowerCase();
    let matchedType = null;

    pills.forEach(pill => {
      const type = (pill.getAttribute('data-category-type') || '').trim();
      const typeLower = type.toLowerCase();
      if (!matchedType) {
        if (typeLower === rawReq) {
          matchedType = type;
        } else if (rawReq.includes(typeLower) || typeLower.includes(rawReq)) {
          matchedType = type;
        } else if (rawReq.includes('serum') && typeLower.includes('serum')) {
          matchedType = type;
        } else if (rawReq.includes('cleanser') && typeLower.includes('cleanser')) {
          matchedType = type;
        } else if ((rawReq.includes('cream') || rawReq.includes('balm') || rawReq.includes('moisturizer')) &&
                   (typeLower.includes('cream') || typeLower.includes('balm') || typeLower.includes('moisturizer'))) {
          matchedType = type;
        } else if (rawReq.includes('body') && typeLower.includes('body')) {
          matchedType = type;
        }
      }
    });

    if (matchedType) {
      // Migrate legacy ?category= URL to Shopify native /collections/types?q=
      const targetUrl = new URL(window.location.origin + '{{ routes.collections_url }}/types');
      targetUrl.searchParams.set('q', matchedType);
      const sortBy = params.get('sort_by');
      if (sortBy) targetUrl.searchParams.set('sort_by', sortBy);
      window.location.replace(targetUrl.toString());
    } else {
      // Unmatched category: render honest empty state
      const grid = document.querySelector('.product-grid');
      const countEl = document.querySelector('.facets__count-text');
      const pagination = document.querySelector('.pagination');
      if (pagination) pagination.remove();
      if (countEl) countEl.textContent = '0 formulations';
      if (grid) {
        const safeReq = categoryParam.replace(/[&<>"']/g, function(m) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[m];
        });
        grid.innerHTML = `
          <div class="main-collection__empty">
            <p>{{ 'collections.general.no_matches' | t }}</p>
            <p class="main-collection__empty-subtext" style="margin-top: var(--space-2); font-size: var(--font-size-sm); color: var(--color-text-muted);">
              No formulations found matching "${safeReq}".
            </p>
            <a href="{{ routes.all_products_collection_url }}" class="btn-primary" style="margin-top: var(--space-6);">
              {{ 'collections.general.view_all_products' | t }}
            </a>
          </div>
        `;
      }
    }
  })();
</script>

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Desktop columns"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 12,
      "label": "Products per page"
    },
    {
      "type": "checkbox",
      "id": "show_category_pills",
      "default": true,
      "label": "Show category filter pills"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "Show secondary image on hover"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show product vendor"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    }
  ]
}
{% endschema %}

