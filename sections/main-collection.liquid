{%- paginate collection.products by section.settings.products_per_page -%}
  <div class="main-collection page-container section-spacing">
    
    <!-- Collection Banner & Header -->
    <header class="main-collection__header">
      <div class="main-collection__header-content">
        <h1 class="main-collection__title">{{ collection.title | escape }}</h1>
        
        {%- if collection.description != blank -%}
          <div class="main-collection__description">
            {{ collection.description }}
          </div>
        {%- endif -%}
      </div>

      <!-- Category Navigation Pills -->
      {%- if section.settings.show_category_pills and collection.all_types.size > 1 -%}
        <div class="category-pills" role="region" aria-label="Filter by formulation category">
          <ul class="category-pills__list" role="tablist">
            <li role="presentation">
              <button 
                type="button" 
                class="category-pill category-pill--active" 
                role="tab" 
                aria-selected="true" 
                data-category-filter="all"
              >
                {{ 'collections.general.all_products' | t }} <span class="category-pill__count">({{ collection.all_products_count | default: collection.products_count }})</span>
              </button>
            </li>
            {%- for type in collection.all_types -%}
              {%- if type != blank -%}
                {%- assign type_count = 0 -%}
                {%- for prod in collection.products -%}
                  {%- if prod.type == type -%}
                    {%- assign type_count = type_count | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
                <li role="presentation">
                  <button 
                    type="button" 
                    class="category-pill" 
                    role="tab" 
                    aria-selected="false" 
                    data-category-filter="{{ type | escape }}"
                  >
                    {{ type | escape }}
                    {%- if type_count > 0 -%}
                      <span class="category-pill__count">({{ type_count }})</span>
                    {%- endif -%}
                  </button>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <!-- Storefront Faceted Filtering & Sorting -->
      {% render 'facets', results: collection, enable_filtering: section.settings.enable_filtering, enable_sorting: section.settings.enable_sorting %}
    </header>

    <!-- Product Grid -->
    <div class="product-grid product-grid--{{ section.settings.columns_desktop }}-col">
      {%- for product in collection.products -%}
        <div class="product-grid__item">
          {% render 'product-card', 
             product: product, 
             show_secondary_image: section.settings.show_secondary_image, 
             show_vendor: section.settings.show_vendor 
          %}
        </div>
      {%- else -%}
        <div class="main-collection__empty">
          <p>{{ 'collections.general.no_matches' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn-primary" style="margin-top: var(--space-4);">
            {{ 'collections.general.view_all_products' | t }}
          </a>
        </div>
      {%- endfor -%}
    </div>

    <!-- Pagination -->
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
        <ul class="pagination__list" role="list">
          {%- if paginate.previous -%}
            <li>
              <a href="{{ paginate.previous.url }}" class="pagination__item pagination__item--prev" aria-label="{{ 'general.pagination.previous' | t }}">
                &larr;
              </a>
            </li>
          {%- endif -%}

          {%- for part in paginate.parts -%}
            <li>
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="pagination__item" aria-label="{{ 'general.pagination.page' | t: number: part.title | default: part.title }}">
                  {{ part.title }}
                </a>
              {%- else -%}
                {%- if part.title == paginate.current_page -%}
                  <span class="pagination__item pagination__item--current" aria-current="page">
                    {{ part.title }}
                  </span>
                {%- else -%}
                  <span class="pagination__item pagination__item--gap">&hellip;</span>
                {%- endif -%}
              {%- endif -%}
            </li>
          {%- endfor -%}

          {%- if paginate.next -%}
            <li>
              <a href="{{ paginate.next.url }}" class="pagination__item pagination__item--next" aria-label="{{ 'general.pagination.next' | t }}">
                &rarr;
              </a>
            </li>
          {%- endif -%}
        </ul>
      </nav>
    {%- endif -%}

  </div>
{%- endpaginate -%}

<style>
  .main-collection__header {
    margin-bottom: var(--space-12);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-6);
  }
  .main-collection__title {
    margin-bottom: var(--space-3);
  }
  .main-collection__description {
    font-size: var(--font-size-md);
    color: var(--color-text-muted);
    max-width: 680px;
    margin-bottom: var(--space-6);
  }
  .main-collection__toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-4);
  }
  .main-collection__count {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
  .main-collection__sort-select {
    font-size: var(--font-size-sm);
    color: var(--color-text);
    background: transparent;
    border: 1px solid var(--color-border-dark);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    outline: none;
    cursor: pointer;
  }
  
  /* The Responsive Product Grid */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  @media (max-width: 480px) {
    .product-grid {
      gap: var(--space-3);
    }
  }
  @media (min-width: 768px) {
    .product-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
    }
  }
  @media (min-width: 1200px) {
    .product-grid--4-col {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .main-collection__empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: var(--space-20) 0;
    color: var(--color-text-muted);
  }

  /* Category Navigation Pills */
  .category-pills {
    margin-top: var(--space-4);
    margin-bottom: var(--space-4);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 4px;
  }
  .category-pills::-webkit-scrollbar {
    display: none;
  }
  .category-pills__list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: nowrap;
  }
  @media (min-width: 990px) {
    .category-pills__list {
      flex-wrap: wrap;
    }
  }
  .category-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    min-height: 44px;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--transition-fast);
    white-space: nowrap;
    text-decoration: none;
    user-select: none;
  }
  .category-pill:hover {
    color: var(--color-text);
    border-color: var(--color-border-dark);
  }
  .category-pill--active,
  .category-pill[aria-selected="true"] {
    color: var(--color-surface);
    background-color: var(--color-text);
    border-color: var(--color-text);
  }
  .category-pill__count {
    font-size: 11px;
    opacity: 0.75;
  }
</style>

<script>
  (function() {
    const pills = document.querySelectorAll('.category-pill');
    const items = document.querySelectorAll('.product-grid__item');
    if (!pills.length || !items.length) return;

    function filterByCategory(category, updateHistory) {
      pills.forEach(p => {
        const isMatch = (p.getAttribute('data-category-filter') === category);
        p.classList.toggle('category-pill--active', isMatch);
        p.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });

      let visible = 0;
      items.forEach(item => {
        const card = item.querySelector('.product-card');
        const cardType = card ? card.getAttribute('data-product-type') : '';
        if (category === 'all' || cardType === category) {
          item.style.display = '';
          visible++;
        } else {
          item.style.display = 'none';
        }
      });

      if (updateHistory) {
        const url = new URL(window.location.href);
        if (category === 'all') {
          url.searchParams.delete('category');
        } else {
          url.searchParams.set('category', category);
        }
        window.history.replaceState({}, '', url.toString());
      }
    }

    pills.forEach(pill => {
      pill.addEventListener('click', function(e) {
        e.preventDefault();
        const cat = this.getAttribute('data-category-filter');
        filterByCategory(cat, true);
      });
    });

    const params = new URLSearchParams(window.location.search);
    const initialCat = params.get('category');
    if (initialCat) {
      filterByCategory(initialCat, false);
    }
  })();
</script>

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Desktop columns"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 12,
      "label": "Products per page"
    },
    {
      "type": "checkbox",
      "id": "show_category_pills",
      "default": true,
      "label": "Show category filter pills"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "Show secondary image on hover"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show product vendor"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    }
  ]
}
{% endschema %}

