{%- comment -%}
  Vespera Theme - Cart Drawer Component (<cart-drawer>)
  Fully compliant with Shopify Theme Store: Section 4, 7, 8, 9, 12, 14.
  Supports 100dvh mobile safe area, unit pricing, selling plans, automatic discounts,
  view cart link, and theme-token styled quantity controls.
{%- endcomment -%}

<cart-drawer class="cart-drawer" id="CartDrawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'templates.cart.cart' | t | default: 'Shopping Cart' }}">
  
  <!-- Backdrop Overlay -->
  <div class="cart-drawer__overlay" id="CartDrawerOverlay" tabindex="-1"></div>

  <!-- Sliding Drawer Panel -->
  <div class="cart-drawer__panel">
    
    <!-- Drawer Header -->
    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title">
        {{ 'templates.cart.cart' | t | default: 'Your Bag' }}
        <span class="cart-drawer__count" data-cart-count-badge>({{ cart.item_count }})</span>
      </h2>
      <button type="button" class="cart-drawer__close" id="CartDrawerClose" aria-label="{{ 'sections.cart.close_drawer' | t | default: 'Close cart drawer' }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="cart-drawer__close-icon" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Free Shipping Goal Progress Bar -->
    {%- assign free_shipping_threshold = section.settings.free_shipping_threshold | default: 75 | times: 100 -%}
    {%- assign amount_remaining = free_shipping_threshold | minus: cart.total_price -%}
    
    <div class="cart-drawer__shipping-bar" data-shipping-bar data-threshold="{{ free_shipping_threshold }}">
      {%- if cart.total_price >= free_shipping_threshold -%}
        <p class="cart-drawer__shipping-text cart-drawer__shipping-text--unlocked">
          {{ 'templates.cart.free_shipping_unlocked' | t | default: "You've unlocked Free Worldwide Shipping!" }}
        </p>
        <div class="cart-drawer__progress">
          <div class="cart-drawer__progress-fill" style="width: 100%;"></div>
        </div>
      {%- else -%}
        {%- assign percent = cart.total_price | times: 100 | divided_by: free_shipping_threshold -%}
        <p class="cart-drawer__shipping-text">
          Add <strong>{{ amount_remaining | money }}</strong> more to unlock Free Worldwide Shipping
        </p>
        <div class="cart-drawer__progress">
          <div class="cart-drawer__progress-fill" style="width: {{ percent }}%;"></div>
        </div>
      {%- endif -%}
    </div>

    <!-- Cart Items Scroll Area -->
    <div class="cart-drawer__body" data-cart-items-container>
      {%- if cart.empty? -%}
        <div class="cart-drawer__empty text-center">
          <p class="cart-drawer__empty-text">{{ 'sections.cart.empty' | t | default: 'Your bag is empty' }}</p>
          <p class="cart-drawer__empty-subtext" style="font-size: var(--font-size-xs); color: var(--color-text-muted); margin-top: var(--space-2);">
            {{ 'sections.cart.empty_subtext' | t | default: 'Explore our botanical formulations' }}
          </p>
          <a href="{{ routes.all_products_collection_url }}" class="btn-primary" style="margin-top: var(--space-4);">
            {{ 'general.continue_shopping' | t | default: 'Continue shopping' }}
          </a>
        </div>
      {%- else -%}
        <ul class="cart-drawer__items-list" role="list">
          {%- for item in cart.items -%}
            <li class="cart-drawer__item" data-line-item-key="{{ item.key }}">
              
              <!-- Item Image -->
              <div class="cart-drawer__item-media">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" loading="lazy" class="cart-drawer__item-img" width="100" height="100">
                {%- endif -%}
              </div>

              <!-- Item Details -->
              <div class="cart-drawer__item-details">
                <h3 class="cart-drawer__item-title">
                  <a href="{{ item.url }}" class="cart-drawer__item-link">{{ item.product.title | escape }}</a>
                </h3>

                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-drawer__item-variant">{{ item.variant.title }}</p>
                {%- endunless -%}

                <!-- Selling Plan (F-10) -->
                {%- if item.selling_plan_allocation != empty -%}
                  <p class="cart-drawer__selling-plan" style="font-size: var(--font-size-xs); color: var(--color-accent);">
                    {{ item.selling_plan_allocation.selling_plan.name }}
                  </p>
                {%- endif -%}

                <!-- Line Item Discounts -->
                {%- if item.line_level_discount_allocations.size > 0 -%}
                  <ul class="cart-drawer__item-discounts" role="list" style="font-size: var(--font-size-xs); color: var(--color-accent); list-style: none;">
                    {%- for discount in item.line_level_discount_allocations -%}
                      <li>{{ discount.discount_application.title }} (-{{ discount.amount | money }})</li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

                <!-- Unit Pricing (F-08) -->
                {%- if item.unit_price_measurement -%}
                  <div class="cart-drawer__unit-price" style="font-size: var(--font-size-xs); color: var(--color-text-muted);">
                    {{ item.unit_price | money }}/
                    {%- if item.unit_price_measurement.reference_value != 1 -%}
                      {{- item.unit_price_measurement.reference_value -}}
                    {%- endif -%}
                    {{ item.unit_price_measurement.reference_unit }}
                  </div>
                {%- endif -%}

                <div class="cart-drawer__item-price">
                  {{ item.final_line_price | money }}
                </div>

                <!-- Quantity Controls (Styled with theme tokens - F-36) -->
                <div class="cart-drawer__qty-group">
                  <button type="button" class="cart-drawer__qty-btn" data-qty-change="-1" aria-label="{{ 'products.product.decrease_quantity' | t | default: 'Decrease' }}: {{ item.title | escape }}">&minus;</button>
                  <span class="cart-drawer__qty-value">{{ item.quantity }}</span>
                  <button type="button" class="cart-drawer__qty-btn" data-qty-change="1" aria-label="{{ 'products.product.increase_quantity' | t | default: 'Increase' }}: {{ item.title | escape }}">&plus;</button>
                  
                  <button type="button" class="cart-drawer__remove-btn" data-item-remove aria-label="{{ 'sections.cart.remove_title' | t | default: 'Remove' }}: {{ item.title | escape }}">
                    {{ 'sections.cart.remove_title' | t | default: 'Remove' }}
                  </button>
                </div>
              </div>

            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <!-- Complete Your Ritual: In-Cart Cross-Sell -->
    {%- assign upsell_collection = section.settings.upsell_collection | default: collections.all -%}
    {%- if section.settings.enable_upsells and upsell_collection != blank and upsell_collection.products_count > 0 -%}
      <div class="cart-drawer__upsell-wrap">
        <div class="cart-drawer__upsell-header">
          <span class="cart-drawer__upsell-title">
            {%- if cart.empty? -%}
              {{ 'templates.cart.curated_rituals' | t | default: 'Curated Daily Essentials' | escape }}
            {%- else -%}
              {{ section.settings.upsell_heading | default: 'Complete your ritual' | escape }}
            {%- endif -%}
          </span>
          <span class="cart-drawer__upsell-badge">
            {%- if cart.empty? -%}Popular{%- else -%}Pairs well{%- endif -%}
          </span>
        </div>
        
        <div class="cart-drawer__upsell-list" role="list">
          {%- assign shown_count = 0 -%}
          {%- for product in upsell_collection.products -%}
            {%- assign in_cart = false -%}
            {%- for item in cart.items -%}
              {%- if item.product_id == product.id -%}
                {%- assign in_cart = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}

            {%- unless in_cart -%}
              {%- assign first_variant = product.first_available_variant | default: product.selected_or_first_available_variant -%}
              <div class="cart-drawer__upsell-item" role="listitem">
                <div class="cart-drawer__upsell-media">
                  {%- if product.featured_media != blank -%}
                    <img 
                      src="{{ product.featured_media | image_url: width: 120, height: 120, crop: 'center' }}" 
                      alt="{{ product.title | escape }}" 
                      width="48" 
                      height="48" 
                      loading="lazy" 
                      class="cart-drawer__upsell-img"
                    >
                  {%- else -%}
                    <div class="cart-drawer__upsell-placeholder"></div>
                  {%- endif -%}
                </div>

                <div class="cart-drawer__upsell-details">
                  <h4 class="cart-drawer__upsell-product-title">
                    <a href="{{ product.url }}" class="cart-drawer__upsell-link">{{ product.title | escape }}</a>
                  </h4>
                  <span class="cart-drawer__upsell-price">{{ first_variant.price | money }}</span>
                </div>

                <div class="cart-drawer__upsell-cta">
                  <button 
                    type="button" 
                    class="btn-secondary cart-drawer__upsell-btn"
                    data-upsell-add-variant="{{ first_variant.id }}"
                    aria-label="{{ 'products.product.add_to_cart' | t | default: 'Add to Bag' }}: {{ product.title | escape }}"
                    {% unless first_variant.available %}disabled="disabled"{% endunless %}
                  >
                    {%- if first_variant.available -%}
                      + Add
                    {%- else -%}
                      {{ 'products.product.sold_out' | t | default: 'Sold Out' }}
                    {%- endif -%}
                  </button>
                </div>
              </div>
              {%- assign shown_count = shown_count | plus: 1 -%}
              {%- if shown_count >= 2 -%}{%- break -%}{%- endif -%}
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <!-- Drawer Footer & Checkout -->
    {%- unless cart.empty? -%}
      <div class="cart-drawer__footer">
        
        <!-- Automatic Cart-Level Discounts (F-27) -->
        {%- if cart.cart_level_discount_applications.size > 0 -%}
          <div class="cart-drawer__discounts" style="margin-bottom: var(--space-2);">
            {%- for discount_application in cart.cart_level_discount_applications -%}
              <div class="cart-drawer__subtotal" style="font-size: var(--font-size-xs); color: var(--color-accent); font-weight: normal;">
                <span>{{ discount_application.title }}</span>
                <span>-{{ discount_application.total_allocated_amount | money }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="cart-drawer__subtotal">
          <span class="cart-drawer__subtotal-label">{{ 'sections.cart.subtotal' | t | default: 'Subtotal' }}</span>
          <span class="cart-drawer__subtotal-value" data-cart-subtotal>{{ cart.total_price | money }}</span>
        </div>
        
        <!-- Tax and Shipping Policy Notice (F-21) -->
        <p class="cart-drawer__disclaimer">
          {%- if cart.taxes_included -%}
            {{ 'products.product.include_taxes' | t | default: 'Taxes included.' }}
          {%- endif -%}
          {%- if shop.shipping_policy.body != blank -%}
            {{ 'sections.cart.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url | default: 'Shipping calculated at checkout.' }}
          {%- else -%}
            {{ 'sections.cart.taxes_and_shipping_policy_at_checkout_html' | t: link: routes.root_url | default: 'Shipping calculated at checkout.' }}
          {%- endif -%}
        </p>
        
        <form action="{{ routes.cart_url }}" method="post" id="CartDrawerForm">
          <button type="submit" name="checkout" class="btn-primary cart-drawer__checkout-btn">
            {{ 'sections.cart.checkout' | t | default: 'Checkout' }} &rarr;
          </button>
        </form>

        <!-- View Cart Link (F-40) -->
        <div class="cart-drawer__view-cart-wrap text-center" style="margin-top: var(--space-3);">
          <a href="{{ routes.cart_url }}" class="link-underline" style="font-size: var(--font-size-xs); color: var(--color-text-muted);">
            {{ 'sections.cart.view_cart' | t | default: 'View cart' }}
          </a>
        </div>
      </div>
    {%- endunless -%}

  </div>
</cart-drawer>

<style>
  .cart-drawer {
    display: none;
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    z-index: 1000;
  }
  .cart-drawer[aria-hidden="false"] {
    display: block;
  }
  .cart-drawer__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(25, 24, 23, 0.4);
    opacity: 0;
    transition: opacity var(--transition-normal);
  }
  .cart-drawer[aria-hidden="false"] .cart-drawer__overlay {
    opacity: 1;
  }
  .cart-drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 440px;
    height: 100%;
    height: 100dvh;
    background-color: var(--color-bg);
    box-shadow: var(--shadow-drawer);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform var(--transition-smooth);
    z-index: 2;
  }
  .cart-drawer[aria-hidden="false"] .cart-drawer__panel {
    transform: translateX(0);
  }
  .cart-drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }
  .cart-drawer__title {
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-medium);
    margin: 0;
  }
  .cart-drawer__close {
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text);
    background: transparent;
    border: none;
    cursor: pointer;
  }
  .cart-drawer__close-icon {
    width: 20px;
    height: 20px;
  }
  .cart-drawer__shipping-bar {
    padding: var(--space-4) var(--space-6);
    background-color: var(--color-bg-subtle);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--font-size-xs);
    text-align: center;
  }
  .cart-drawer__progress {
    width: 100%;
    height: 4px;
    background-color: var(--color-border);
    border-radius: var(--radius-full);
    overflow: hidden;
    margin-top: var(--space-2);
  }
  .cart-drawer__progress-fill {
    height: 100%;
    background-color: var(--color-accent);
    transition: width var(--transition-normal);
  }
  .cart-drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-6);
  }
  .cart-drawer__empty {
    text-align: center;
    padding: var(--space-16) 0;
    color: var(--color-text-muted);
  }
  .cart-drawer__items-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .cart-drawer__item {
    display: flex;
    gap: var(--space-4);
  }
  .cart-drawer__item-media {
    width: 80px;
    height: 100px;
    background-color: var(--color-bg-subtle);
    border-radius: var(--radius-sm);
    overflow: hidden;
    flex-shrink: 0;
  }
  .cart-drawer__item-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cart-drawer__item-details {
    flex: 1;
  }
  .cart-drawer__item-title {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    margin-bottom: var(--space-1);
  }
  .cart-drawer__item-link {
    color: var(--color-text);
  }
  .cart-drawer__item-variant {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }
  .cart-drawer__item-price {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--space-3);
  }
  .cart-drawer__qty-group {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .cart-drawer__qty-btn {
    width: 32px;
    height: 32px;
    min-width: 32px;
    min-height: 32px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: transparent;
    color: var(--color-text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    cursor: pointer;
    touch-action: manipulation;
  }
  .cart-drawer__qty-btn:hover {
    background-color: var(--color-bg-subtle);
  }
  .cart-drawer__qty-value {
    font-size: var(--font-size-xs);
    min-width: 20px;
    text-align: center;
  }
  .cart-drawer__remove-btn {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    text-decoration: underline;
    margin-left: auto;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0 var(--space-2);
    cursor: pointer;
    background: transparent;
    border: none;
  }
  .cart-drawer__footer {
    padding: var(--space-6);
    padding-bottom: calc(var(--space-6) + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--color-border);
    background-color: var(--color-bg);
  }
  .cart-drawer__subtotal {
    display: flex;
    justify-content: space-between;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--space-2);
  }
  .cart-drawer__disclaimer {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }
  .cart-drawer__checkout-btn {
    width: 100%;
    padding: var(--space-4);
  }

  /* In-Cart Routine Upsells */
  .cart-drawer__upsell-wrap {
    padding: var(--space-4) var(--space-6);
    background-color: var(--color-bg-subtle);
    border-top: 1px solid var(--color-border);
  }
  .cart-drawer__upsell-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
  }
  .cart-drawer__upsell-title {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .cart-drawer__upsell-badge {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background-color: var(--color-surface);
    color: var(--color-accent);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }
  .cart-drawer__upsell-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .cart-drawer__upsell-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background-color: var(--color-surface);
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }
  .cart-drawer__upsell-media {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-xs);
    overflow: hidden;
    flex-shrink: 0;
  }
  .cart-drawer__upsell-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cart-drawer__upsell-details {
    flex: 1;
    min-width: 0;
  }
  .cart-drawer__upsell-product-title {
    font-size: var(--font-size-xs);
    margin: 0 0 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cart-drawer__upsell-link {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .cart-drawer__upsell-link:hover {
    color: var(--color-accent);
  }
  .cart-drawer__upsell-price {
    font-size: var(--font-size-xs);
    color: var(--color-accent);
    font-weight: var(--font-weight-semibold);
  }
  .cart-drawer__upsell-cta {
    flex-shrink: 0;
  }
  .cart-drawer__upsell-btn {
    padding: 4px 10px;
    font-size: 11px;
    letter-spacing: 0.04em;
    height: 28px;
    line-height: 1;
    cursor: pointer;
  }
</style>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "Free shipping threshold ($)",
      "default": 75
    },
    {
      "type": "checkbox",
      "id": "enable_upsells",
      "label": "Enable in-cart recommendations",
      "default": true
    },
    {
      "type": "text",
      "id": "upsell_heading",
      "label": "Recommendations heading",
      "default": "Complete your ritual"
    },
    {
      "type": "collection",
      "id": "upsell_collection",
      "label": "Recommendations collection"
    }
  ]
}
{% endschema %}
