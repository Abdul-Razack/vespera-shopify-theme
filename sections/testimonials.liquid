{%- comment -%}
  Vespera Theme - Testimonials & Press Section
  Editorial accolades and customer reviews with verified star ratings.
{%- endcomment -%}

<div class="testimonials section-spacing" id="Testimonials-{{ section.id }}">
  <div class="page-container">
    
    <!-- Section Header -->
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="testimonials__header text-center">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="testimonials__title font-heading">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Testimonials Grid -->
    <div class="testimonials__grid" style="--t-columns-desktop: {{ section.settings.columns_desktop }};">
      {%- for block in section.blocks -%}
        <div class="testimonials__card" {{ block.shopify_attributes }}>
          
          <!-- Star Rating -->
          {%- if block.settings.rating > 0 -%}
            <div class="testimonials__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..block.settings.rating) -%}
                <svg class="testimonials__star-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <!-- Quote Content -->
          {%- if block.settings.quote != blank -%}
            <blockquote class="testimonials__quote font-heading">
              &ldquo;{{ block.settings.quote | escape }}&rdquo;
            </blockquote>
          {%- endif -%}

          <!-- Author Credential -->
          <div class="testimonials__author-wrapper">
            {%- if block.settings.author != blank -%}
              <cite class="testimonials__author">{{ block.settings.author | escape }}</cite>
            {%- endif -%}

            {%- if block.settings.publication_subtitle != blank -%}
              <span class="testimonials__sub">{{ block.settings.publication_subtitle | escape }}</span>
            {%- endif -%}
          </div>

        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

<style>
  .testimonials__header {
    max-width: 600px;
    margin: 0 auto var(--space-8);
  }
  .testimonials__title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .testimonials__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  @media (min-width: 768px) {
    .testimonials__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
  }
  @media (min-width: 1024px) {
    .testimonials__grid {
      grid-template-columns: repeat(var(--t-columns-desktop, 3), 1fr);
      gap: var(--space-8);
    }
  }
  .testimonials__card {
    display: flex;
    flex-direction: column;
    padding: var(--space-8);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: transform var(--transition-normal);
  }
  .testimonials__card:hover {
    transform: translateY(-3px);
  }
  .testimonials__stars {
    display: flex;
    gap: 3px;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }
  .testimonials__star-icon {
    width: 16px;
    height: 16px;
  }
  .testimonials__quote {
    font-size: var(--font-size-base);
    line-height: var(--line-height-relaxed);
    color: var(--color-text);
    margin: 0 0 var(--space-6);
    font-style: italic;
    flex-grow: 1;
  }
  .testimonials__author-wrapper {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
  }
  .testimonials__author {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-style: normal;
    color: var(--color-text);
  }
  .testimonials__sub {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }
</style>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Subheading",
      "default": "Acclaim & Recognition"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Celebrated by Connoisseurs"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 3,
      "label": "Columns on desktop"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Quote",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Star Rating"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote text",
          "default": "The gold standard of botanical luxury. Within days, skin feels visibly calmer and undeniably radiant."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author / Source",
          "default": "Vogue Editorial"
        },
        {
          "type": "text",
          "id": "publication_subtitle",
          "label": "Subtitle / Verified Badge",
          "default": "Beauty Awards Winner"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "The gold standard of botanical skincare. Within days, complexion feels visibly balanced and radiant.",
            "author": "Vogue Editorial",
            "publication_subtitle": "Annual Clean Beauty Awards"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "A masterclass in conscious chemistry. It replaces four steps in my morning ritual effortlessly.",
            "author": "Dr. Clara Hastings",
            "publication_subtitle": "Integrative Dermatologist"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "Rarely does a formulation deliver such instant tactile luxury while respecting sensitive skin barriers.",
            "author": "Harper's Bazaar",
            "publication_subtitle": "Editor's Pick 2026"
          }
        }
      ]
    }
  ]
}
{% endschema %}
