<div class="faq-section section-spacing" data-section-id="{{ section.id }}">
  <div class="page-container page-container--narrow">
    
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-header text-center">
        {%- if section.settings.eyebrow != blank -%}
          <span class="section-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="section-description">{{ section.settings.subtext | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="faq-accordion" role="list">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <details class="faq-item" {{ block.shopify_attributes }} role="listitem" {% if forloop.first %}open{% endif %}>
            <summary class="faq-item__summary">
              <span class="faq-item__question">{{ block.settings.question | escape }}</span>
              <span class="faq-item__icon" aria-hidden="true">&plus;</span>
            </summary>
            <div class="faq-item__answer rte">
              {{ block.settings.answer }}
            </div>
          </details>
        {%- endfor -%}
      {%- else -%}
        <!-- Default Curated Botanical Skincare FAQs -->
        <details class="faq-item" role="listitem" open>
          <summary class="faq-item__summary">
            <span class="faq-item__question">What sets Vespera&rsquo;s Clinical Botany standard apart?</span>
            <span class="faq-item__icon" aria-hidden="true">&plus;</span>
          </summary>
          <div class="faq-item__answer rte">
            <p>Every formulation is crafted in small batches combining supercritical CO2 cold-pressed botanical extracts with double-blind verified bio-actives (Multi-Molecular Hyaluronic Acid, Phyto-Squalane, Niacinamide). We never dilute with synthetic fillers, parabens, or artificial fragrance.</p>
          </div>
        </details>

        <details class="faq-item" role="listitem">
          <summary class="faq-item__summary">
            <span class="faq-item__question">How does Complimentary Worldwide Shipping work?</span>
            <span class="faq-item__icon" aria-hidden="true">&plus;</span>
          </summary>
          <div class="faq-item__answer rte">
            <p>We provide complimentary carbon-neutral worldwide shipping on all orders over $75. Orders under $75 ship via express tracked carrier at flat standard rates. Every order includes complimentary deluxe ritual samples.</p>
          </div>
        </details>

        <details class="faq-item" role="listitem">
          <summary class="faq-item__summary">
            <span class="faq-item__question">Are Vespera glass vessels recyclable and UV-protective?</span>
            <span class="faq-item__icon" aria-hidden="true">&plus;</span>
          </summary>
          <div class="faq-item__answer rte">
            <p>Yes. We house all formulations in biophotonic UV-protective glass vessels. This shields delicate plant terpene profiles from photodegradation, preserving botanical potency naturally without harsh chemical preservatives. All glass is 100% infinitely recyclable.</p>
          </div>
        </details>

        <details class="faq-item" role="listitem">
          <summary class="faq-item__summary">
            <span class="faq-item__question">Are formulations safe for sensitive skin barriers?</span>
            <span class="faq-item__icon" aria-hidden="true">&plus;</span>
          </summary>
          <div class="faq-item__answer rte">
            <p>All formulations undergo independent dermatological safety evaluations and are balanced at optimal barrier pH (5.2&ndash;5.6). Because of our high concentrations of pure botanical actives, we recommend patch testing on clean forearm skin 24 hours prior to ritual integration.</p>
          </div>
        </details>

        <details class="faq-item" role="listitem">
          <summary class="faq-item__summary">
            <span class="faq-item__question">What is your 30-day conscious return policy?</span>
            <span class="faq-item__icon" aria-hidden="true">&plus;</span>
          </summary>
          <div class="faq-item__answer rte">
            <p>We offer a 30-day conscious ritual guarantee. If a formulation does not harmonize with your skin barrier, simply contact our concierge team for a seamless return or customized ritual exchange.</p>
          </div>
        </details>
      {%- endif -%}
    </div>

  </div>
</div>

<style>
  .faq-section {
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }
  .page-container--narrow {
    max-width: 820px;
  }
  .faq-accordion {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--color-border);
  }
  .faq-item {
    border-top: 1px solid var(--color-border);
    transition: background-color var(--transition-fast);
  }
  .faq-item__summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-5) 0;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .faq-item__summary::-webkit-details-marker {
    display: none;
  }
  .faq-item__summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .faq-item__question {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
    padding-right: var(--space-4);
    line-height: 1.4;
  }
  .faq-item__icon {
    font-size: 20px;
    line-height: 1;
    color: var(--color-text-muted);
    transition: transform var(--transition-fast), color var(--transition-fast);
    flex-shrink: 0;
  }
  .faq-item[open] .faq-item__icon {
    transform: rotate(45deg);
    color: var(--color-accent);
  }
  .faq-item__answer {
    padding-bottom: var(--space-6);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
  }
  .faq-item__answer p:last-child {
    margin-bottom: 0;
  }
</style>

{% schema %}
{
  "name": "FAQ and ritual guidance",
  "tag": "section",
  "class": "section-faq",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Formulation & Delivery Rituals"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Everything you need to know about our conscious clinical standards, packaging, and worldwide care."
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What sets Vespera's Clinical Botany standard apart?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Every formulation is crafted in small batches combining supercritical CO2 cold-pressed botanical extracts with double-blind verified bio-actives.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ and ritual guidance",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "What sets Vespera's Clinical Botany standard apart?",
            "answer": "<p>Every formulation is crafted in small batches combining supercritical CO2 cold-pressed botanical extracts with double-blind verified bio-actives.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How does Complimentary Worldwide Shipping work?",
            "answer": "<p>We provide complimentary carbon-neutral worldwide shipping on all orders over $75.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Are Vespera glass vessels recyclable and UV-protective?",
            "answer": "<p>Yes. We house all formulations in biophotonic UV-protective glass vessels that shield plant extracts from photodegradation.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
