<div class="press-marquee" data-section-id="{{ section.id }}">
  <div class="page-container">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="press-marquee__header text-center">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="press-marquee__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Press Quotes Grid / Carousel -->
    <div class="press-marquee__grid" id="PressMarqueeGrid-{{ section.id }}" role="list">
      {%- for block in section.blocks -%}
        <article class="press-marquee__card" {{ block.shopify_attributes }} role="listitem">
          <div class="press-marquee__rating" aria-label="{{ 'sections.press_marquee.rating' | t }}">
            ★★★★★
          </div>
          <blockquote class="press-marquee__quote">
            &ldquo;{{ block.settings.quote | escape }}&rdquo;
          </blockquote>
          <cite class="press-marquee__publication">
            {{ block.settings.publication | escape }}
          </cite>
        </article>
      {%- endfor -%}
    </div>

    <!-- Mobile Swipe Indicator Dots ($380 Commercial Luxury Benchmark) -->
    {%- assign quote_count = section.blocks.size -%}
    {%- if quote_count > 1 -%}
      <div class="press-marquee__indicators" id="PressMarqueeDots-{{ section.id }}" aria-hidden="true">
        {%- for i in (1..quote_count) -%}
          <span class="press-marquee__indicator{% if forloop.first %} is-active{% endif %}" data-dot-index="{{ forloop.index0 }}"></span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .press-marquee {
    position: relative;
    background-color: var(--color-bg-subtle, #FAF8F5);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding-top: var(--space-16);
    padding-bottom: var(--space-20);
    overflow: hidden;
  }

  .press-marquee__header {
    max-width: 680px;
    margin: 0 auto var(--space-8);
  }

  @media (min-width: 768px) {
    .press-marquee__header {
      margin-bottom: var(--space-10);
    }
  }

  .press-marquee__title {
    font-family: var(--font-heading-family);
    font-size: clamp(1.85rem, 3.2vw, 2.5rem);
    font-weight: var(--font-heading-weight);
    letter-spacing: var(--letter-spacing-heading);
    line-height: 1.25;
    color: var(--color-text);
    margin: 0;
  }

  .press-marquee__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    align-items: stretch;
  }

  .press-marquee__card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-8);
    background-color: var(--color-surface, #FFFFFF);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-align: center;
    box-shadow: 0 4px 20px rgba(44, 42, 41, 0.04);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .press-marquee__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(44, 42, 41, 0.08);
  }

  .press-marquee__rating {
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    letter-spacing: 0.25em;
    margin-bottom: var(--space-4);
    line-height: 1;
  }

  .press-marquee__quote {
    font-family: var(--font-heading-family);
    font-size: var(--font-size-base);
    line-height: var(--line-height-relaxed, 1.6);
    color: var(--color-text);
    margin: 0 0 var(--space-6) 0;
    font-style: italic;
    flex-grow: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .press-marquee__publication {
    font-family: var(--font-body-family);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    font-style: normal;
    display: block;
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .press-marquee__indicators {
    display: none;
  }

  @media (max-width: 768px) {
    .press-marquee {
      padding-top: var(--space-10);
      padding-bottom: var(--space-12);
    }

    .press-marquee__header {
      margin-bottom: var(--space-6);
    }

    .press-marquee__grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: var(--space-4);
      padding: var(--space-2) var(--space-4) var(--space-4);
      margin-left: calc(-1 * var(--container-padding, 16px));
      margin-right: calc(-1 * var(--container-padding, 16px));
      scrollbar-width: none;
    }

    .press-marquee__grid::-webkit-scrollbar {
      display: none;
    }

    .press-marquee__card {
      flex: 0 0 84%;
      max-width: 84%;
      scroll-snap-align: center;
      padding: var(--space-6);
      min-height: 200px;
    }

    .press-marquee__quote {
      font-size: 0.95rem;
      margin-bottom: var(--space-4);
    }

    .press-marquee__indicators {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 6px;
      margin-top: var(--space-3);
    }

    .press-marquee__indicator {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background-color: var(--color-border);
      transition: background-color var(--transition-fast), width var(--transition-fast), border-radius var(--transition-fast);
      cursor: pointer;
    }

    .press-marquee__indicator.is-active {
      background-color: var(--color-accent);
      width: 18px;
      border-radius: 9999px;
    }
  }
</style>

<script>
  (function() {
    const grid = document.getElementById('PressMarqueeGrid-{{ section.id }}');
    const dotsWrap = document.getElementById('PressMarqueeDots-{{ section.id }}');
    if (!grid || !dotsWrap) return;

    const dots = dotsWrap.querySelectorAll('.press-marquee__indicator');
    const cards = grid.querySelectorAll('.press-marquee__card');
    if (!dots.length || !cards.length) return;

    let isScrolling = false;

    grid.addEventListener('scroll', function() {
      if (isScrolling) return;
      isScrolling = true;
      requestAnimationFrame(function() {
        const scrollLeft = grid.scrollLeft;
        const cardWidth = cards[0].offsetWidth;
        const activeIndex = Math.min(cards.length - 1, Math.max(0, Math.round(scrollLeft / (cardWidth + 16))));
        
        dots.forEach((dot, idx) => {
          dot.classList.toggle('is-active', idx === activeIndex);
        });
        isScrolling = false;
      });
    }, { passive: true });

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        if (cards[idx]) {
          cards[idx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Press and awards",
  "tag": "section",
  "class": "section-press-marquee",
  "settings": [
    {
      "type": "paragraph",
      "content": "Merchant Guidance: All press quotes, publication names, and media features must be genuine, substantiated, and authorized for use by your brand. Replace sample editorial quotes with verified coverage received by your store."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Editorial Acclaim"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured In The Press"
    }
  ],
  "blocks": [
    {
      "type": "press_quote",
      "name": "Press quote",
      "settings": [
        {
          "type": "text",
          "id": "publication",
          "label": "Publication name",
          "default": "Sample Publication",
          "info": "Authorized publication or media outlet name."
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "An editorial excerpt from a substantiated media publication that has reviewed your formulations."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press and awards",
      "blocks": [
        {
          "type": "press_quote",
          "settings": {
            "publication": "Editorial Feature",
            "quote": "A thoughtful approach to botanical precision without synthetic compromises. An everyday essential."
          }
        },
        {
          "type": "press_quote",
          "settings": {
            "publication": "Skincare Review",
            "quote": "Nourishing formulations designed for conscious daily rituals. Pure restorative care in glass packaging."
          }
        }
      ]
    }
  ]
}
{% endschema %}

