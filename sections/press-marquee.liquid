<div class="press-marquee" data-section-id="{{ section.id }}">
  <div class="page-container">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="press-marquee__header text-center">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | default: 'Editorial Accolades' | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="press-marquee__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Press Quotes Grid / Carousel -->
    <div class="press-marquee__grid" role="list">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <article class="press-marquee__card" {{ block.shopify_attributes }} role="listitem">
            <div class="press-marquee__rating" aria-label="5 out of 5 stars">
              ★★★★★
            </div>
            <blockquote class="press-marquee__quote">
              &ldquo;{{ block.settings.quote | escape }}&rdquo;
            </blockquote>
            <cite class="press-marquee__publication">
              {{ block.settings.publication | escape }}
            </cite>
          </article>
        {%- endfor -%}
      {%- else -%}
        <!-- Default Editorial Accolades -->
        <article class="press-marquee__card" role="listitem">
          <div class="press-marquee__rating" aria-label="5 out of 5 stars">★★★★★</div>
          <blockquote class="press-marquee__quote">
            &ldquo;A masterclass in modern conscious formulation. The Botanical Radiance Serum is unmatched in bio-active purity.&rdquo;
          </blockquote>
          <cite class="press-marquee__publication">Vogue International</cite>
        </article>

        <article class="press-marquee__card" role="listitem">
          <div class="press-marquee__rating" aria-label="5 out of 5 stars">★★★★★</div>
          <blockquote class="press-marquee__quote">
            &ldquo;Clinically proven botanical precision without synthetic compromises. The new benchmark for luxury daily ritual.&rdquo;
          </blockquote>
          <cite class="press-marquee__publication">Harper&rsquo;s Bazaar</cite>
        </article>

        <article class="press-marquee__card" role="listitem">
          <div class="press-marquee__rating" aria-label="5 out of 5 stars">★★★★★</div>
          <blockquote class="press-marquee__quote">
            &ldquo;94% moisture barrier retention backed by independent studies. Pure sustainable luxury in UV-protective glass.&rdquo;
          </blockquote>
          <cite class="press-marquee__publication">Allure Magazine</cite>
        </article>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .press-marquee {
    background-color: var(--color-bg-subtle, #FAF8F5);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding-top: var(--space-16);
    padding-bottom: var(--space-20);
  }

  .press-marquee__header {
    max-width: 680px;
    margin: 0 auto var(--space-8);
  }

  @media (min-width: 768px) {
    .press-marquee__header {
      margin-bottom: var(--space-10);
    }
  }

  .press-marquee__title {
    font-family: var(--font-heading-family);
    font-size: clamp(1.85rem, 3.2vw, 2.5rem);
    font-weight: var(--font-heading-weight);
    letter-spacing: var(--letter-spacing-heading);
    line-height: 1.25;
    color: var(--color-text);
    margin: 0;
  }

  .press-marquee__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    align-items: stretch;
  }

  .press-marquee__card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-8);
    background-color: var(--color-surface, #FFFFFF);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-align: center;
    box-shadow: 0 4px 20px rgba(44, 42, 41, 0.04);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .press-marquee__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(44, 42, 41, 0.08);
  }

  .press-marquee__rating {
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    letter-spacing: 0.25em;
    margin-bottom: var(--space-4);
    line-height: 1;
  }

  .press-marquee__quote {
    font-family: var(--font-heading-family);
    font-size: var(--font-size-base);
    line-height: var(--line-height-relaxed, 1.6);
    color: var(--color-text);
    margin: 0 0 var(--space-6) 0;
    font-style: italic;
    flex-grow: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .press-marquee__publication {
    font-family: var(--font-body-family);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    font-style: normal;
    display: block;
    margin-top: auto;
    padding-top: var(--space-2);
  }

  @media (max-width: 900px) {
    .press-marquee {
      padding-top: var(--space-12);
      padding-bottom: var(--space-16);
    }

    .press-marquee__grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .press-marquee__card {
      padding: var(--space-6);
    }
  }
</style>

{% schema %}
{
  "name": "Editorial Press & Awards",
  "tag": "section",
  "class": "section-press-marquee",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Recognized Excellence"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What The Press Is Saying"
    }
  ],
  "blocks": [
    {
      "type": "press_quote",
      "name": "Press Quote",
      "settings": [
        {
          "type": "text",
          "id": "publication",
          "label": "Publication Name",
          "default": "Vogue International"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "A masterclass in modern conscious formulation. The Botanical Radiance Serum is unmatched in bio-active purity."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial Press & Awards",
      "blocks": [
        {
          "type": "press_quote",
          "settings": {
            "publication": "Vogue International",
            "quote": "A masterclass in modern conscious formulation. The Botanical Radiance Serum is unmatched in bio-active purity."
          }
        },
        {
          "type": "press_quote",
          "settings": {
            "publication": "Harper's Bazaar",
            "quote": "Clinically proven botanical precision without synthetic compromises. The new benchmark for luxury daily ritual."
          }
        },
        {
          "type": "press_quote",
          "settings": {
            "publication": "Allure Magazine",
            "quote": "94% moisture barrier retention backed by independent studies. Pure sustainable luxury in UV-protective glass."
          }
        }
      ]
    }
  ]
}
{% endschema %}

