{%- if section.settings.show_announcement -%}
  <div class="announcement-bar" role="region" aria-label="{{ 'sections.top_bar.label' | t }}" data-section-id="{{ section.id }}">
    <div class="page-container announcement-bar__inner">
      {%- assign total_slides = section.blocks.size -%}
      {%- if total_slides > 1 -%}
        <button type="button" class="announcement-bar__nav-btn announcement-bar__nav-btn--prev" id="AnnouncementPrev" aria-label="{{ 'sections.announcements.previous' | t }}">&lsaquo;</button>
      {%- endif -%}

      <div class="announcement-bar__slider" id="AnnouncementSlider" aria-live="polite">
        {%- if total_slides > 0 -%}
          {%- for block in section.blocks -%}
            <div class="announcement-bar__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }} data-index="{{ forloop.index0 }}">
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="announcement-bar__link">
                  {{ block.settings.text | escape }}
                  <span class="announcement-bar__arrow" aria-hidden="true">&rarr;</span>
                </a>
              {%- else -%}
                <p class="announcement-bar__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="announcement-bar__slide is-active" data-index="0">
            {%- if section.settings.link != blank -%}
              <a href="{{ section.settings.link }}" class="announcement-bar__link">
                {{ section.settings.text | escape }}
                <span class="announcement-bar__arrow" aria-hidden="true">&rarr;</span>
              </a>
            {%- else -%}
              <p class="announcement-bar__text">{{ section.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if total_slides > 1 -%}
        <button type="button" class="announcement-bar__nav-btn announcement-bar__nav-btn--next" id="AnnouncementNext" aria-label="{{ 'sections.announcements.next' | t }}">&rsaquo;</button>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

<style>
  .announcement-bar {
    background-color: var(--color-text);
    color: var(--color-surface);
    padding: 6px 0;
    font-size: var(--font-size-xs);
    letter-spacing: 0.05em;
    text-align: center;
    position: relative;
    z-index: 10;
  }
  .announcement-bar__inner {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 24px;
    position: relative;
  }
  .announcement-bar__slider {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 600px;
    overflow: hidden;
  }
  .announcement-bar__slide {
    display: none;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 350ms ease, transform 350ms ease;
    width: 100%;
  }
  .announcement-bar__slide.is-active {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }
  .announcement-bar__text,
  .announcement-bar__link {
    color: var(--color-surface);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
    margin: 0;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .announcement-bar__link:hover {
    text-decoration: underline;
  }
  .announcement-bar__arrow {
    margin-left: var(--space-2);
  }
  .announcement-bar__nav-btn {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.7);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: color var(--transition-fast);
  }
  .announcement-bar__nav-btn:hover {
    color: #FFFFFF;
  }
  @media (max-width: 600px) {
    .announcement-bar {
      padding: 8px 0;
    }
    .announcement-bar__text,
    .announcement-bar__link {
      font-size: 11px;
      white-space: normal;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
  }
</style>

<script>
  (function() {
    const slider = document.getElementById('AnnouncementSlider');
    if (!slider) return;

    const slides = Array.from(slider.querySelectorAll('.announcement-bar__slide'));
    if (slides.length <= 1) return;

    let currentIndex = 0;
    let timer = null;

    function goToSlide(index) {
      slides[currentIndex].classList.remove('is-active');
      currentIndex = (index + slides.length) % slides.length;
      slides[currentIndex].classList.add('is-active');
    }

    function startAutoPlay() {
      stopAutoPlay();
      timer = setInterval(() => {
        goToSlide(currentIndex + 1);
      }, 4500);
    }

    function stopAutoPlay() {
      if (timer) clearInterval(timer);
    }

    const prevBtn = document.getElementById('AnnouncementPrev');
    const nextBtn = document.getElementById('AnnouncementNext');

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        goToSlide(currentIndex - 1);
        startAutoPlay();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        goToSlide(currentIndex + 1);
        startAutoPlay();
      });
    }

    slider.addEventListener('mouseenter', stopAutoPlay);
    slider.addEventListener('mouseleave', startAutoPlay);

    // Initial start
    startAutoPlay();
  })();
</script>

