{%- if section.settings.show_announcement and section.settings.text != blank -%}
  <div class="announcement-bar" role="region" aria-label="{{ 'sections.header.announcement' | t | default: 'Announcement' }}">
    <div class="page-container announcement-bar__inner">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="announcement-bar__link">
          {{ section.settings.text | escape }}
          <span class="announcement-bar__arrow" aria-hidden="true">&rarr;</span>
        </a>
      {%- else -%}
        <p class="announcement-bar__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

<style>
  .announcement-bar {
    background-color: var(--color-text);
    color: var(--color-surface);
    padding: var(--space-2) 0;
    font-size: var(--font-size-xs);
    letter-spacing: 0.05em;
    text-align: center;
  }
  .announcement-bar__inner {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .announcement-bar__text,
  .announcement-bar__link {
    color: var(--color-surface);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
  }
  .announcement-bar__link:hover {
    text-decoration: underline;
  }
  .announcement-bar__arrow {
    margin-left: var(--space-2);
  }
</style>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "Complimentary luxury samples & free worldwide shipping on orders over $75"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement link"
    }
  ]
}
{% endschema %}

