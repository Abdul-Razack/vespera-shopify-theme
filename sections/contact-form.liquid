<div class="contact-section section-spacing" data-section-id="{{ section.id }}">
  <div class="page-container">
    <div class="contact-section__grid">
      
      <!-- Left Column: Concierge Details & Brand Studio -->
      <div class="contact-section__concierge">
        {%- if section.settings.eyebrow != blank -%}
          <span class="section-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        
        <h2 class="contact-section__title">
          {{ section.settings.heading | escape }}
        </h2>

        <p class="contact-section__subtext">
          {{ section.settings.subtext | escape }}
        </p>

        <div class="contact-section__cards">
          <div class="concierge-card">
            <span class="concierge-card__label">{{ 'templates.contact.form.inquiries' | t }}</span>
            <a href="mailto:{{ section.settings.email }}" class="concierge-card__val">
              {{ section.settings.email }}
            </a>
          </div>

          <div class="concierge-card">
            <span class="concierge-card__label">{{ 'templates.contact.form.hours' | t }}</span>
            <span class="concierge-card__val">{{ section.settings.hours }}</span>
          </div>

          <div class="concierge-card">
            <span class="concierge-card__label">{{ 'templates.contact.form.response_standard' | t }}</span>
            <span class="concierge-card__val">{{ 'templates.contact.form.response_time' | t }}</span>
          </div>

          <div class="concierge-card">
            <span class="concierge-card__label">{{ 'templates.contact.form.lab' | t }}</span>
            <span class="concierge-card__val">{{ section.settings.location }}</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Form -->
      <div class="contact-section__form-wrapper">
        {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
          
          {%- if form.posted_successfully? -%}
            <div class="contact-form__success" role="status" tabindex="-1" autofocus>
              <span class="contact-form__success-icon" aria-hidden="true">&check;</span>
              <div>
                <strong>{{ 'templates.contact.form.post_success_title' | t }}</strong>
                <p class="contact-form__success-text">
                  {{ 'templates.contact.form.post_success' | t }}
                </p>
              </div>
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="contact-form__error" role="alert">
              <strong>{{ 'templates.contact.form.error_heading' | t }}</strong>
              <ul>
                {%- for field in form.errors -%}
                  <li>
                    {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="contact-form__field-row">
            <!-- Full Name -->
            <div class="contact-form__field">
              <label for="ContactForm-name" class="contact-form__label">
                {{ 'templates.contact.form.name' | t }} <span aria-hidden="true">*</span>
              </label>
              <input 
                type="text" 
                id="ContactForm-name" 
                name="contact[{{ 'templates.contact.form.name' | t }}]" 
                class="contact-form__input" 
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="{{ 'templates.contact.form.name_placeholder' | t }}"
                required
                autocomplete="name"
              >
            </div>

            <!-- Email Address -->
            <div class="contact-form__field">
              <label for="ContactForm-email" class="contact-form__label">
                {{ 'templates.contact.form.email' | t }} <span aria-hidden="true">*</span>
              </label>
              <input 
                type="email" 
                id="ContactForm-email" 
                name="contact[email]" 
                class="contact-form__input" 
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                placeholder="{{ 'templates.contact.form.email_placeholder' | t }}"
                spellcheck="false"
                autocomplete="email"
                autocapitalize="off"
                required
                {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
              >
            </div>
          </div>

          <div class="contact-form__field-row">
            <!-- Order / Batch Number (Optional) -->
            <div class="contact-form__field">
              <label for="ContactForm-order" class="contact-form__label">
                {{ 'templates.contact.form.phone' | t }}
              </label>
              <input 
                type="text" 
                id="ContactForm-order" 
                name="contact[order_number]" 
                class="contact-form__input" 
                placeholder="{{ 'templates.contact.form.order_number_placeholder' | t }}"
              >
            </div>

            <!-- Topic Selector -->
            <div class="contact-form__field">
              <label for="ContactForm-topic" class="contact-form__label">
                {{ 'templates.contact.form.topic' | t }}
              </label>
              <select id="ContactForm-topic" name="contact[topic]" class="contact-form__select">
                {%- assign topic_lines = section.settings.topic_options | newline_to_br | split: '<br />' -%}
                {%- for topic in topic_lines -%}
                  {%- assign topic_clean = topic | strip -%}
                  {%- if topic_clean != blank -%}
                    <option value="{{ topic_clean | escape }}">{{ topic_clean | escape }}</option>
                  {%- endif -%}
                {%- endfor -%}
              </select>
            </div>
          </div>

          <!-- Message -->
          <div class="contact-form__field">
            <label for="ContactForm-body" class="contact-form__label">
              {{ 'templates.contact.form.comment' | t }} <span aria-hidden="true">*</span>
            </label>
            <textarea 
              rows="6" 
              id="ContactForm-body" 
              name="contact[{{ 'templates.contact.form.comment' | t }}]" 
              class="contact-form__textarea" 
              placeholder="{{ 'templates.contact.form.comment_placeholder' | t }}"
              required
            >{{ form.body }}</textarea>
          </div>

          <button type="submit" class="btn-primary contact-form__submit-btn">
            {{ 'templates.contact.form.send' | t }} &rarr;
          </button>

        {%- endform -%}
      </div>

    </div>
  </div>
</div>

<style>
  .contact-section {
    background-color: var(--color-bg);
  }
  .contact-section__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
  }
  @media (min-width: 990px) {
    .contact-section__grid {
      grid-template-columns: 1fr 1.3fr;
      gap: var(--space-16);
      align-items: start;
    }
  }
  .contact-section__title {
    font-family: var(--font-serif);
    font-size: var(--font-size-2xl);
    line-height: 1.25;
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }
  .contact-section__subtext {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-8);
  }
  .contact-section__cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-6);
  }
  .concierge-card {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .concierge-card__label {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
  }
  .concierge-card__val {
    font-size: var(--font-size-sm);
    color: var(--color-text);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
  }
  a.concierge-card__val:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* Form Styling */
  .contact-section__form-wrapper {
    background-color: var(--color-surface, #FFFFFF);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-8);
    box-shadow: var(--shadow-subtle);
  }
  @media (min-width: 768px) {
    .contact-section__form-wrapper {
      padding: var(--space-10);
    }
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .contact-form__field-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }
  @media (min-width: 600px) {
    .contact-form__field-row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .contact-form__label {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }
  .contact-form__input,
  .contact-form__select,
  .contact-form__textarea {
    width: 100%;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    font-size: var(--font-size-sm);
    color: var(--color-text);
    font-family: inherit;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .contact-form__input:focus,
  .contact-form__select:focus,
  .contact-form__textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
  }
  .contact-form__textarea {
    resize: vertical;
  }
  .contact-form__submit-btn {
    align-self: flex-start;
    padding: var(--space-4) var(--space-8);
    font-size: var(--font-size-sm);
    cursor: pointer;
  }
  @media (max-width: 599px) {
    .contact-form__submit-btn {
      width: 100%;
    }
  }
  .contact-form__success {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    background-color: rgba(46, 125, 50, 0.08);
    border: 1px solid rgba(46, 125, 50, 0.25);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-sm);
    color: var(--color-text);
    line-height: 1.5;
  }
  .contact-form__success-icon {
    color: #2e7d32;
    font-weight: bold;
    font-size: var(--font-size-lg);
  }
  .contact-form__success-text {
    margin-top: 4px;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }
  .contact-form__error {
    padding: var(--space-4);
    background-color: rgba(211, 47, 47, 0.08);
    border: 1px solid rgba(211, 47, 47, 0.25);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-xs);
    color: #d32f2f;
  }
  .contact-form__error ul {
    margin: var(--space-2) 0 0 var(--space-4);
    padding: 0;
  }
</style>

{% schema %}
{
  "name": "Customer care contact",
  "tag": "section",
  "class": "section-contact-form",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Personalized Guidance"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer care and formulation concierge"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Whether you are seeking tailored skincare ritual guidance, batch code verification, or delivery tracking, our botanical team is at your disposal."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Concierge email",
      "default": "concierge@vesperabotanicals.com"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Hours of operation",
      "default": "Monday – Friday, 9:00 AM – 6:00 PM EST"
    },
    {
      "type": "text",
      "id": "location",
      "label": "Location footprint",
      "default": "Hudson Valley Formulation Studio"
    },
    {
      "type": "textarea",
      "id": "topic_options",
      "label": "Inquiry topic options",
      "info": "Enter one option per line",
      "default": "Tailored Skincare Ritual Guidance\nOrder Status & Shipping Inquiries\nSustainable Packaging & Glass Refills\nPress, Editorial & Partnerships\nGeneral Inquiries"
    }
  ],
  "presets": [
    {
      "name": "Customer care contact"
    }
  ]
}
{% endschema %}
