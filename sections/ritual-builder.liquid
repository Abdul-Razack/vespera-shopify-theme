{{ 'signature-commerce.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ritual-builder.js' | asset_url }}" defer="defer"></script>
<ritual-builder class="ritual-builder section-spacing section-spacing--editorial" id="Ritual-{{ section.id }}"
  data-add-url="{{ routes.cart_add_url }}.js" data-cart-url="{{ routes.cart_url }}" data-update-url="{{ routes.cart_update_url }}.js"
  data-currency="{{ cart.currency.iso_code }}" data-locale="{{ request.locale.iso_code }}" data-discount="{{ section.settings.discount_code | strip | escape }}"
  data-empty="{{ 'sections.ritual.empty' | t | escape }}" data-error="{{ 'sections.ritual.error' | t | escape }}"
  data-uncertain="{{ 'sections.ritual.uncertain' | t | escape }}" data-success="{{ 'sections.ritual.success' | t | escape }}"
  data-discount-note="{{ 'sections.ritual.discount_check' | t | escape }}" data-adding="{{ 'products.product.adding' | t | escape }}">
  <div class="page-container">
    <header class="signature-heading">
      <div><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2 class="section-title" id="RitualHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
      <div class="signature-heading__intro rte">{{ section.settings.text }}</div>
    </header>
    <form data-ritual-form action="{{ routes.cart_url }}" method="get" aria-labelledby="RitualHeading-{{ section.id }}">
      <div class="ritual-builder__steps">
        {%- for block in section.blocks -%}
          <fieldset class="ritual-step" data-ritual-step {{ block.shopify_attributes }}>
            <legend><span class="ritual-step__number">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span> {{ block.settings.title | escape }}</legend>
            <label class="ritual-step__toggle"><input type="checkbox" data-ritual-toggle {% if block.settings.included %}checked{% endif %} {% if block.settings.products == blank %}disabled{% endif %}> {{ 'sections.ritual.include' | t }}</label>
            <p class="ritual-step__description">{{ block.settings.text | escape }}</p>
            {%- if block.settings.products != blank -%}
              <div class="ritual-step__choices">
                {%- for ritual_product in block.settings.products -%}
                  {%- capture choice_id -%}{{ section.id }}-{{ block.id }}-{{ forloop.index }}{%- endcapture -%}
                  {% render 'ritual-product', ritual_product: ritual_product, choice_index: forloop.index0, choice_id: choice_id %}
                {%- endfor -%}
              </div>
              {%- if block.settings.products.size > 1 -%}
                <label class="ritual-step__swap" for="RitualSwap-{{ section.id }}-{{ block.id }}">{{ 'sections.ritual.swap' | t }}</label>
                <select id="RitualSwap-{{ section.id }}-{{ block.id }}" data-ritual-swap>
                  {%- for ritual_product in block.settings.products -%}<option value="{{ forloop.index0 }}">{{ ritual_product.title | escape }}</option>{%- endfor -%}
                </select>
              {%- endif -%}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'ritual-step__placeholder' }}
              <p>{{ 'sections.ritual.configure' | t }}</p>
            {%- endif -%}
          </fieldset>
        {%- endfor -%}
      </div>
      <footer class="ritual-builder__footer">
        <div><span class="eyebrow">{{ 'sections.ritual.total' | t }}</span><output class="ritual-builder__total" data-ritual-total aria-live="polite">{{ 0 | money_with_currency }}</output><p class="ritual-builder__terms">{{ 'sections.ritual.terms' | t }}</p>
        {% if section.settings.discount_code != blank %}<p class="ritual-builder__terms">{{ 'sections.ritual.discount_offer' | t: code: section.settings.discount_code | escape }}</p>{% endif %}</div>
        <button class="btn-primary" type="submit" data-ritual-add disabled>{{ 'sections.ritual.add' | t }} <span aria-hidden="true">→</span></button>
      </footer>
      <p class="ritual-builder__status" data-ritual-status role="status" aria-live="polite"></p>
      <a href="{{ routes.cart_url }}" class="link-underline" data-ritual-cart hidden>{{ 'sections.cart.view_cart' | t }}</a>
      <noscript><p>{{ 'sections.ritual.no_script' | t }}</p></noscript>
    </form>
  </div>
</ritual-builder>

{% schema %}
{
  "name": "Curated ritual builder",
  "tag": "section",
  "class": "section-ritual-builder",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The art of daily care"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your ritual. Your rhythm."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction",
      "default": "<p>Three considered steps. Choose your formulations and create a daily ritual that feels like yours.</p>"
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Existing Shopify discount code",
      "info": "Optional. Create the code and its eligibility, minimum quantities and combination rules in Shopify Discounts first. The displayed total is before discounts; Shopify confirms savings in the cart. This setting does not create a discount."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Ritual step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step title",
          "default": "Cleanse"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Short description",
          "default": "Begin with a fresh canvas."
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Curated products",
          "limit": 4,
          "info": "The first product is selected initially. Additional products become swap options. Subscription-only products cannot be added here."
        },
        {
          "type": "checkbox",
          "id": "included",
          "label": "Include step by default",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Curated ritual builder",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Purify & cleanse",
            "text": "Begin with a fresh canvas."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Tone & balance",
            "text": "A moment to refresh and prepare."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Nourish & restore",
            "text": "Complete your ritual with considered care."
          }
        }
      ]
    }
  ]
}
{% endschema %}
