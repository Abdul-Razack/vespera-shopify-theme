<section class="hero-editorial section-spacing" aria-labelledby="HeroHeading-{{ section.id }}">
  <div class="page-container">
    <div class="hero-editorial__layout">

      <!-- Content Column (Left on Desktop) -->
      <div class="hero-editorial__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}

        <h1 id="HeroHeading-{{ section.id }}" class="hero-editorial__heading">
          {{ section.settings.heading | escape }}
        </h1>

        <p class="hero-editorial__subtext">
          {{ section.settings.subtext | escape }}
        </p>

        <div class="hero-editorial__actions">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn-primary hero-banner__btn">
              {{ section.settings.button_label | escape }}
            </a>
          {%- endif -%}

          {%- if section.settings.secondary_button_label != blank and section.settings.secondary_button_link != blank -%}
            <a href="{{ section.settings.secondary_button_link }}" class="hero-editorial__secondary-link">
              {{ section.settings.secondary_button_label | escape }} <span aria-hidden="true">&rarr;</span>
            </a>
          {%- endif -%}
        </div>

        <!-- Highlight Metrics -->
        {%- if section.blocks.size > 0 -%}
          <div class="hero-editorial__metrics">
            {%- for block in section.blocks -%}
              <div class="hero-editorial__metric-item" {{ block.shopify_attributes }}>
                <span class="hero-editorial__metric-value">{{ block.settings.value | escape }}</span>
                <span class="hero-editorial__metric-label">{{ block.settings.label | escape }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Visual Media Column (Right on Desktop) -->
      <div class="hero-editorial__media-wrapper">
        <div class="hero-editorial__image-card">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1200 | image_tag:
               loading: 'eager',
               fetchpriority: 'high',
               widths: '480, 800, 1200',
               sizes: '(min-width: 1440px) 660px, (min-width: 991px) 50vw, calc(100vw - 32px)',
               class: 'hero-editorial__image',
               alt: section.settings.heading | escape
            }}
          {%- else -%}
            <img
              src="{{ 'hero-editorial-800.webp' | asset_url }}"
              srcset="{{ 'hero-editorial-480.webp' | asset_url }} 480w, {{ 'hero-editorial-800.webp' | asset_url }} 800w, {{ 'hero-editorial-896.webp' | asset_url }} 896w"
              sizes="(min-width: 1440px) 660px, (min-width: 991px) 50vw, calc(100vw - 32px)"
              alt="{{ section.settings.heading | escape }}"
              class="hero-editorial__image"
              loading="eager"
              fetchpriority="high"
              width="896"
              height="1200"
            >
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .hero-editorial {
    background-color: var(--color-bg);
  }
  .hero-editorial__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: center;
  }
  @media (min-width: 991px) {
    .hero-editorial__layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: clamp(32px, 4vw, 64px);
    }
  }
  .hero-editorial__content,
  .hero-editorial__media-wrapper {
    min-width: 0;
  }
  .hero-editorial__heading {
    font-size: var(--font-size-display);
    line-height: 1.08;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    margin-bottom: var(--space-6);
    max-width: 15ch;
  }
  .hero-editorial__subtext {
    font-size: var(--font-size-md);
    color: var(--color-text-muted);
    max-width: 480px;
    margin-bottom: var(--space-8);
  }
  .hero-editorial__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .hero-editorial__secondary-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    padding-block: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    border-bottom: 1px solid var(--color-border-dark);
  }
  .hero-editorial__secondary-link:hover {
    border-bottom-color: currentColor;
  }
  .hero-editorial__metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-6);
    max-width: 500px;
  }
  .hero-editorial__metric-item {
    display: flex;
    flex-direction: column;
  }
  .hero-editorial__metric-value {
    font-family: var(--font-serif);
    font-size: var(--font-size-xl);
    color: var(--color-text);
    font-weight: var(--font-weight-medium);
  }
  .hero-editorial__metric-label {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-top: var(--space-1);
  }
  .hero-editorial__media-wrapper {
    position: relative;
  }
  .hero-editorial__image-card {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-bg-subtle);
    box-shadow: var(--shadow-subtle);
  }
  .hero-editorial__image {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .hero-editorial__placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    background-color: var(--color-bg-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-editorial__placeholder-svg {
    width: 100%;
    height: 100%;
  }
</style>

{% schema %}
{
  "name": "Editorial hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Subheading",
      "default": "Mindful Botany • Conscious Rituals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Formulated to Elevate Your Natural Radiance"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Description",
      "default": "Selected botanical extracts blended with cold-pressed plant oils. Designed for conscious daily rituals."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Explore Formulations"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Our Philosophy"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link",
      "info": "Destination page or collection URL. If left empty, the button is hidden."
    }
  ],
  "blocks": [
    {
      "type": "metric",
      "name": "Metric highlight",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Metric value",
          "default": "12"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Metric label",
          "default": "Botanical extracts"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial hero",
      "blocks": [
        {
          "type": "metric",
          "settings": {
            "value": "12",
            "label": "Botanical extracts"
          }
        },
        {
          "type": "metric",
          "settings": {
            "value": "3",
            "label": "Ritual steps"
          }
        },
        {
          "type": "metric",
          "settings": {
            "value": "24h",
            "label": "Nourishing care"
          }
        }
      ]
    }
  ]
}
{% endschema %}

