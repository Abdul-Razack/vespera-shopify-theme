{%- comment -%}
  Vespera Theme - Main Header Component (Online Store 2.0)
  Complies with Shopify Theme Store: Section 4, 7, 8, 9, 12, 14.
  Features: Multi-level dropdown menus (F-48), <shopify-account> on desktop AND mobile (F-15),
  focus-trapped mobile drawer (F-33), accessible predictive search drawer.
{%- endcomment -%}

<header class="site-header{% if section.settings.enable_sticky_header %} site-header--sticky{% endif %}" role="banner">
  <div class="page-container site-header__inner">
    
    <!-- Mobile Menu Toggle Button -->
    <button 
      type="button" 
      class="site-header__mobile-toggle" 
      id="MobileNavToggle"
      aria-label="{{ 'sections.header.menu' | t | default: 'Open Menu' }}"
      aria-expanded="false"
      aria-controls="MobileNavDrawer"
    >
      <span class="site-header__icon-bar" aria-hidden="true"></span>
      <span class="site-header__icon-bar" aria-hidden="true"></span>
    </button>

    <!-- Brand Logo / Title -->
    <div class="site-header__logo-wrapper">
      <a href="{{ routes.root_url }}" class="site-header__logo-link">
        {%- if settings.logo != blank -%}
          <img 
            src="{{ settings.logo | image_url: width: 300 }}" 
            alt="{{ settings.logo.alt | default: shop.name | escape }}"
            width="{{ settings.logo_width | default: 120 }}"
            height="auto"
            loading="eager"
            class="site-header__logo-img"
          >
        {%- else -%}
          <span class="site-header__brand-name">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    <!-- Desktop Navigation Menu (Multi-level Support - F-48) -->
    <nav class="site-header__nav" role="navigation" aria-label="{{ 'sections.header.main_menu' | t | default: 'Main Menu' }}">
      <ul class="site-header__nav-list">
        {%- for link in linklists[section.settings.menu].links -%}
          {%- if link.links != blank -%}
            <li class="site-header__nav-item site-header__nav-item--has-dropdown" data-nav-dropdown>
              <button 
                type="button" 
                class="site-header__nav-link site-header__dropdown-toggle"
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls="HeaderDropdown-{{ forloop.index }}"
              >
                <span>{{ link.title | escape }}</span>
                <svg class="site-header__dropdown-arrow" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                  <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <ul class="site-header__dropdown-menu" id="HeaderDropdown-{{ forloop.index }}" role="menu">
                {%- for child_link in link.links -%}
                  <li class="site-header__dropdown-item" role="none">
                    <a 
                      href="{{ child_link.url }}" 
                      class="site-header__dropdown-link{% if child_link.current %} site-header__dropdown-link--active{% endif %}"
                      role="menuitem"
                      {% if child_link.current %}aria-current="page"{% endif %}
                    >
                      {{ child_link.title | escape }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </li>
          {%- else -%}
            <li class="site-header__nav-item">
              <a 
                href="{{ link.url }}" 
                class="site-header__nav-link{% if link.current %} site-header__nav-link--active{% endif %}"
                {% if link.current %}aria-current="page"{% endif %}
              >
                {{ link.title | escape }}
              </a>
            </li>
          {%- endif -%}
        {%- else -%}
          <li class="site-header__nav-item"><a href="{{ routes.all_products_collection_url }}" class="site-header__nav-link">Shop Skincare</a></li>
          <li class="site-header__nav-item"><a href="{{ routes.collections_url }}" class="site-header__nav-link">Collections</a></li>
          <li class="site-header__nav-item"><a href="{{ pages['contact'].url | default: routes.root_url }}" class="site-header__nav-link">Contact</a></li>
        {%- endfor -%}
      </ul>
    </nav>

    <!-- Header Actions (Search, Account & Cart) -->
    <div class="site-header__actions">
      
      <!-- Search Trigger Icon Button -->
      <a 
        href="{{ routes.search_url }}" 
        class="site-header__icon-link site-header__search-toggle" 
        id="HeaderSearchToggle"
        aria-label="{{ 'templates.search.search' | t | default: 'Search formulations' }}"
        aria-expanded="false"
        aria-controls="HeaderSearchModal"
      >
        <svg class="site-header__icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>

      <!-- Native Shopify Account Component - Visible on Both Mobile & Desktop (F-15) -->
      {%- if shop.customer_accounts_enabled -%}
        <div class="site-header__account-slot" aria-label="{{ 'templates.cart.cart' | t | default: 'Account' }}">
          <shopify-account></shopify-account>
        </div>
      {%- endif -%}

      <!-- Cart Icon with Live Bubble -->
      <a 
        href="{{ routes.cart_url }}" 
        class="site-header__icon-link site-header__cart-link" 
        id="CartIconBubble"
        aria-label="{{ cart.item_count }} {{ 'templates.cart.items' | t | default: 'items in cart' }}"
      >
        <svg class="site-header__icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="site-header__cart-count" aria-hidden="true" data-cart-count>{{ cart.item_count }}</span>
      </a>

    </div>

  </div>

  <!-- Header Predictive Search Drawer -->
  <div id="HeaderSearchModal" class="header-search" aria-hidden="true">
    <div class="page-container header-search__inner">
      <predictive-search class="header-search__predictive">
        <form action="{{ routes.search_url }}" method="get" role="search" class="header-search__form">
          <input type="hidden" name="options[prefix]" value="last">
          <button type="submit" class="header-search__submit-btn" aria-label="{{ 'templates.search.submit' | t | default: 'Search Formulations' }}">
            <svg class="header-search__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </button>
          <label for="HeaderSearchInput" class="visually-hidden">{{ 'templates.search.search' | t | default: 'Search formulations' }}</label>
          <input 
            type="search" 
            name="q" 
            id="HeaderSearchInput"
            class="header-search__input" 
            placeholder="{{ 'general.search.placeholder' | t | default: 'Search formulations, ingredients...' }}" 
            aria-label="{{ 'templates.search.search' | t | default: 'Search formulations' }}"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
          >
          <button type="button" class="header-search__close-btn" id="HeaderSearchClose" aria-label="Close search">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </form>
        <div class="predictive-search__results header-search__results" tabindex="-1"></div>
      </predictive-search>
    </div>
  </div>

  <!-- Mobile Navigation Drawer with Focus Trap (F-33) -->
  <div id="MobileNavDrawer" class="mobile-nav-drawer" aria-hidden="true">
    <div class="mobile-nav-drawer__overlay" id="MobileNavOverlay" tabindex="-1"></div>
    <div class="mobile-nav-drawer__panel">
      <div class="mobile-nav-drawer__header">
        <span class="site-header__brand-name">{{ shop.name }}</span>
        <button type="button" class="mobile-nav-drawer__close" id="MobileNavClose" aria-label="Close menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Mobile Search Form inside Drawer -->
      <form action="{{ routes.search_url }}" method="get" role="search" class="mobile-nav-drawer__search">
        <input type="hidden" name="options[prefix]" value="last">
        <svg class="mobile-nav-drawer__search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <label for="MobileNavSearchInput" class="visually-hidden">{{ 'templates.search.search' | t | default: 'Search formulations' }}</label>
        <input 
          type="search" 
          name="q" 
          id="MobileNavSearchInput"
          class="mobile-nav-drawer__search-input" 
          placeholder="{{ 'general.search.placeholder' | t | default: 'Search formulations...' }}" 
          aria-label="{{ 'templates.search.search' | t | default: 'Search formulations' }}"
        >
      </form>

      <!-- Multi-level Mobile Navigation (F-48) -->
      <nav class="mobile-nav-drawer__nav">
        <ul class="mobile-nav-drawer__list">
          {%- for link in linklists[section.settings.menu].links -%}
            {%- if link.links != blank -%}
              <li class="mobile-nav-drawer__item mobile-nav-drawer__item--has-children">
                <details class="mobile-nav-drawer__details">
                  <summary class="mobile-nav-drawer__summary">
                    <span>{{ link.title | escape }}</span>
                    <svg class="mobile-nav-drawer__arrow" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                      <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </summary>
                  <ul class="mobile-nav-drawer__sublist">
                    {%- for child_link in link.links -%}
                      <li class="mobile-nav-drawer__subitem">
                        <a href="{{ child_link.url }}" class="mobile-nav-drawer__sublink{% if child_link.current %} mobile-nav-drawer__sublink--active{% endif %}">
                          {{ child_link.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </details>
              </li>
            {%- else -%}
              <li class="mobile-nav-drawer__item">
                <a href="{{ link.url }}" class="mobile-nav-drawer__link{% if link.current %} mobile-nav-drawer__link--active{% endif %}">
                  {{ link.title | escape }}
                </a>
              </li>
            {%- endif -%}
          {%- else -%}
            <li class="mobile-nav-drawer__item"><a href="{{ routes.all_products_collection_url }}" class="mobile-nav-drawer__link">Shop Skincare</a></li>
            <li class="mobile-nav-drawer__item"><a href="{{ routes.collections_url }}" class="mobile-nav-drawer__link">Collections</a></li>
            <li class="mobile-nav-drawer__item"><a href="{{ pages['contact'].url | default: routes.root_url }}" class="mobile-nav-drawer__link">Contact</a></li>
          {%- endfor -%}
        </ul>
      </nav>

      <!-- Account access inside mobile drawer -->
      {%- if shop.customer_accounts_enabled -%}
        <div class="mobile-nav-drawer__account" style="padding: var(--space-4) var(--space-6); border-top: 1px solid var(--color-border);">
          <shopify-account></shopify-account>
        </div>
      {%- endif -%}

      <!-- Mobile Navigation Drawer Footer / Socials -->
      <div class="mobile-nav-drawer__footer">
        {%- if settings.social_instagram_link != blank or settings.social_tiktok_link != blank or settings.social_pinterest_link != blank -%}
          <div class="mobile-nav-drawer__socials">
            {%- if settings.social_instagram_link != blank -%}
              <a href="{{ settings.social_instagram_link }}" class="mobile-nav-drawer__social-link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </a>
            {%- endif -%}
            {%- if settings.social_tiktok_link != blank -%}
              <a href="{{ settings.social_tiktok_link }}" class="mobile-nav-drawer__social-link" aria-label="TikTok" target="_blank" rel="noopener noreferrer">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
                </svg>
              </a>
            {%- endif -%}
            {%- if settings.social_pinterest_link != blank -%}
              <a href="{{ settings.social_pinterest_link }}" class="mobile-nav-drawer__social-link" aria-label="Pinterest" target="_blank" rel="noopener noreferrer">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="12" y1="9" x2="12" y2="21"></line>
                  <path d="M8 12a4 4 0 1 1 8 0c0 3-2 5-4 5s-2-2-2-3"></path>
                </svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    transition: background-color var(--transition-normal);
    z-index: 100;
  }
  .site-header--sticky {
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .site-header--drawer-open,
  .site-header:has(.mobile-nav-drawer--open) {
    z-index: 999;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
  }
  .site-header__brand-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 175px;
  }
  @media (min-width: 768px) {
    .site-header__brand-name {
      font-size: var(--font-size-xl);
      max-width: none;
    }
  }
  .site-header__nav-list {
    display: none;
    list-style: none;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
  }
  @media (min-width: 768px) {
    .site-header__nav-list {
      display: flex;
      align-items: center;
    }
  }
  .site-header__nav-item {
    position: relative;
  }
  .site-header__nav-link {
    font-size: var(--font-size-sm);
    letter-spacing: 0.04em;
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast);
    padding: var(--space-2) 0;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: transparent;
    border: none;
    cursor: pointer;
  }
  .site-header__nav-link:hover,
  .site-header__nav-link--active {
    color: var(--color-accent);
  }

  /* Dropdown Menu (F-48) */
  .site-header__dropdown-arrow {
    transition: transform var(--transition-fast);
  }
  .site-header__nav-item--has-dropdown:hover .site-header__dropdown-arrow,
  .site-header__nav-item--has-dropdown[data-open="true"] .site-header__dropdown-arrow {
    transform: rotate(180deg);
  }
  .site-header__dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 200px;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-subtle, 0 8px 16px rgba(0,0,0,0.06));
    border-radius: var(--radius-sm);
    list-style: none;
    margin: 0;
    padding: var(--space-2) 0;
    z-index: 110;
  }
  .site-header__nav-item--has-dropdown:hover .site-header__dropdown-menu,
  .site-header__nav-item--has-dropdown[data-open="true"] .site-header__dropdown-menu {
    display: block;
  }
  .site-header__dropdown-item {
    padding: 0;
  }
  .site-header__dropdown-link {
    display: block;
    padding: var(--space-2) var(--space-4);
    font-size: var(--font-size-xs);
    color: var(--color-text);
    text-decoration: none;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }
  .site-header__dropdown-link:hover,
  .site-header__dropdown-link--active {
    background-color: var(--color-bg-subtle);
    color: var(--color-accent);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  @media (min-width: 768px) {
    .site-header__actions {
      gap: var(--space-4);
    }
  }

  /* Account Slot (F-15 Visible on mobile and desktop) */
  .site-header__account-slot {
    display: flex;
    align-items: center;
  }
  .site-header__icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text);
    position: relative;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
  }
  .site-header__icon-svg {
    width: 20px;
    height: 20px;
  }
  .site-header__cart-count {
    position: absolute;
    top: 6px;
    right: 4px;
    background-color: var(--color-text);
    color: var(--color-surface);
    font-size: 10px;
    font-weight: var(--font-weight-semibold);
    width: 18px;
    height: 18px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .site-header__mobile-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }
  @media (min-width: 768px) {
    .site-header__mobile-toggle {
      display: none;
    }
  }
  .site-header__icon-bar {
    width: 20px;
    height: 1.5px;
    background-color: var(--color-text);
  }

  /* Search Drawer */
  .header-search {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-4) 0;
  }
  .header-search--open {
    display: block;
  }
  .header-search__inner {
    max-width: 600px;
    margin: 0 auto;
  }
  .header-search__form {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    background-color: var(--color-surface);
  }
  .header-search__input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: var(--font-size-sm);
    color: var(--color-text);
    outline: none;
  }
  .header-search__submit-btn,
  .header-search__close-btn {
    background: transparent;
    border: none;
    color: var(--color-text);
    cursor: pointer;
    display: flex;
    align-items: center;
  }

  /* Mobile Drawer (F-33 Focus Trapped) */
  .mobile-nav-drawer {
    display: none;
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    z-index: 1000;
  }
  .mobile-nav-drawer--open {
    display: block;
  }
  .mobile-nav-drawer__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(25, 24, 23, 0.4);
  }
  .mobile-nav-drawer__panel {
    position: absolute;
    top: 0;
    left: 0;
    width: 85%;
    max-width: 360px;
    height: 100dvh;
    background-color: var(--color-bg);
    box-shadow: var(--shadow-drawer);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    z-index: 2;
  }
  .mobile-nav-drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }
  .mobile-nav-drawer__close {
    background: transparent;
    border: none;
    color: var(--color-text);
    cursor: pointer;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mobile-nav-drawer__search {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-4) var(--space-6);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
  .mobile-nav-drawer__search-input {
    border: none;
    background: transparent;
    font-size: var(--font-size-xs);
    width: 100%;
    outline: none;
  }
  .mobile-nav-drawer__nav {
    flex: 1;
    padding: var(--space-4) 0;
  }
  .mobile-nav-drawer__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .mobile-nav-drawer__link {
    display: block;
    padding: var(--space-3) var(--space-6);
    font-size: var(--font-size-md);
    color: var(--color-text);
    text-decoration: none;
  }
  .mobile-nav-drawer__summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    font-size: var(--font-size-md);
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
  }
  .mobile-nav-drawer__summary::-webkit-details-marker {
    display: none;
  }
  .mobile-nav-drawer__sublist {
    list-style: none;
    padding: 0 0 0 var(--space-8);
    margin: 0;
    background-color: var(--color-bg-subtle);
  }
  .mobile-nav-drawer__sublink {
    display: block;
    padding: var(--space-2) var(--space-6);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .mobile-nav-drawer__footer {
    padding: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  .mobile-nav-drawer__socials {
    display: flex;
    gap: var(--space-4);
  }
  .mobile-nav-drawer__social-link {
    color: var(--color-text);
    min-height: 24px;
    display: inline-flex;
    align-items: center;
  }
</style>

<script>
  (function() {
    const siteHeader = document.querySelector('.site-header');
    
    // Header Search Toggle
    const searchToggle = document.getElementById('HeaderSearchToggle');
    const searchModal = document.getElementById('HeaderSearchModal');
    const searchClose = document.getElementById('HeaderSearchClose');
    const searchInput = document.getElementById('HeaderSearchInput');

    function openSearch(e) {
      if (e) e.preventDefault();
      if (!searchModal) return;
      searchModal.classList.add('header-search--open');
      searchModal.setAttribute('aria-hidden', 'false');
      if (searchToggle) searchToggle.setAttribute('aria-expanded', 'true');
      if (searchInput) setTimeout(() => searchInput.focus(), 60);
    }

    function closeSearch() {
      if (!searchModal) return;
      searchModal.classList.remove('header-search--open');
      searchModal.setAttribute('aria-hidden', 'true');
      if (searchToggle) {
        searchToggle.setAttribute('aria-expanded', 'false');
        searchToggle.focus();
      }
    }

    if (searchToggle) {
      searchToggle.addEventListener('click', (e) => {
        if (searchModal && searchModal.classList.contains('header-search--open')) {
          e.preventDefault();
          closeSearch();
        } else {
          openSearch(e);
        }
      });
    }

    if (searchClose) searchClose.addEventListener('click', closeSearch);

    // Desktop Dropdown Keyboard Handling (F-48)
    const dropdownItems = document.querySelectorAll('[data-nav-dropdown]');
    dropdownItems.forEach(item => {
      const toggle = item.querySelector('.site-header__dropdown-toggle');
      if (toggle) {
        toggle.addEventListener('click', () => {
          const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
          toggle.setAttribute('aria-expanded', !isExpanded);
          item.setAttribute('data-open', !isExpanded);
        });
      }
    });

    // Dismiss search and dropdowns on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (searchModal && searchModal.classList.contains('header-search--open')) {
          closeSearch();
        }
        dropdownItems.forEach(item => {
          const toggle = item.querySelector('.site-header__dropdown-toggle');
          if (toggle && toggle.getAttribute('aria-expanded') === 'true') {
            toggle.setAttribute('aria-expanded', 'false');
            item.removeAttribute('data-open');
            toggle.focus();
          }
        });
      }
    });

    // Mobile Navigation Drawer Focus Trapping (F-33)
    const mobileToggle = document.getElementById('MobileNavToggle');
    const mobileDrawer = document.getElementById('MobileNavDrawer');
    const mobileClose = document.getElementById('MobileNavClose');
    const mobileOverlay = document.getElementById('MobileNavOverlay');
    let previousActiveElement = null;

    function getMobileFocusable() {
      if (!mobileDrawer) return [];
      return Array.from(mobileDrawer.querySelectorAll(
        'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])'
      )).filter(el => el.offsetWidth > 0 || el.offsetHeight > 0);
    }

    function openMobileDrawer() {
      if (!mobileDrawer) return;
      previousActiveElement = document.activeElement;
      if (siteHeader) siteHeader.classList.add('site-header--drawer-open');
      mobileDrawer.classList.add('mobile-nav-drawer--open');
      mobileDrawer.setAttribute('aria-hidden', 'false');
      if (mobileToggle) mobileToggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';

      requestAnimationFrame(() => {
        if (mobileClose) mobileClose.focus();
      });
    }

    function closeMobileDrawer() {
      if (!mobileDrawer) return;
      if (siteHeader) siteHeader.classList.remove('site-header--drawer-open');
      mobileDrawer.classList.remove('mobile-nav-drawer--open');
      mobileDrawer.setAttribute('aria-hidden', 'true');
      if (mobileToggle) mobileToggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';

      if (previousActiveElement && typeof previousActiveElement.focus === 'function') {
        previousActiveElement.focus();
        previousActiveElement = null;
      }
    }

    if (mobileToggle) {
      mobileToggle.addEventListener('click', (e) => {
        e.preventDefault();
        openMobileDrawer();
      });
    }
    if (mobileClose) mobileClose.addEventListener('click', closeMobileDrawer);
    if (mobileOverlay) mobileOverlay.addEventListener('click', closeMobileDrawer);

    // Trap focus inside mobile drawer
    mobileDrawer.addEventListener('keydown', (e) => {
      if (!mobileDrawer.classList.contains('mobile-nav-drawer--open')) return;
      if (e.key === 'Escape') {
        closeMobileDrawer();
        return;
      }
      if (e.key === 'Tab') {
        const focusable = getMobileFocusable();
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (e.shiftKey && (document.activeElement === first || !mobileDrawer.contains(document.activeElement))) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && (document.activeElement === last || !mobileDrawer.contains(document.activeElement))) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  })();
</script>

