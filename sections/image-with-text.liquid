{%- comment -%}
  Vespera Theme - Image With Text Section
  Editorial split storytelling section with reversible layout and botanical aesthetic.
{%- endcomment -%}

<div class="image-with-text section-spacing section-spacing--editorial {% if section.settings.subtle_bg %}image-with-text--subtle-bg{% endif %}" id="ImageWithText-{{ section.id }}">
  <div id="philosophy" class="section-anchor"></div>
  <div class="page-container">
    <div class="image-with-text__grid {% if section.settings.layout == 'text_first' %}image-with-text__grid--reverse{% endif %}">

      <!-- Media Column -->
      <div class="image-with-text__media-col">
        <div class="image-with-text__media-frame">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1200 | image_tag:
               loading: 'lazy',
               widths: '480, 800, 1200',
               sizes: '(min-width: 1440px) 750px, (min-width: 991px) 58vw, calc(100vw - 32px)',
               class: 'image-with-text__img',
               alt: section.settings.image.alt | default: section.settings.heading | escape
            }}
          {%- else -%}
            <img
              src="{{ 'botanical-extraction-800.webp' | asset_url }}"
              srcset="{{ 'botanical-extraction-480.webp' | asset_url }} 480w, {{ 'botanical-extraction-800.webp' | asset_url }} 800w, {{ 'botanical-extraction-896.webp' | asset_url }} 896w"
              sizes="(min-width: 1440px) 750px, (min-width: 991px) 58vw, calc(100vw - 32px)"
              decoding="async"
              alt="{{ section.settings.heading | escape }}"
              class="image-with-text__img"
              loading="lazy"
              width="896"
              height="1200"
            >
          {%- endif -%}
        </div>
      </div>

      <!-- Content Column -->
      <div class="image-with-text__content-col">
        <div class="image-with-text__content">
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="image-with-text__title font-heading">
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <div class="image-with-text__text rte">
              {{ section.settings.text }}
            </div>
          {%- endif -%}

          {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
            <div class="image-with-text__action">
              <a href="{{ section.settings.button_link }}" class="btn-primary">
                {{ section.settings.button_label | escape }}
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  .image-with-text--subtle-bg {
    background-color: var(--color-surface);
  }
  .image-with-text__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }
  @media (min-width: 991px) {
    .image-with-text__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 0;
    }
    .image-with-text__media-col {
      grid-column: 1 / span 7;
      grid-row: 1;
    }
    .image-with-text__content-col {
      grid-column: 9 / span 4;
      grid-row: 1;
    }
    .image-with-text__grid--reverse .image-with-text__media-col {
      grid-column: 6 / span 7;
    }
    .image-with-text__grid--reverse .image-with-text__content-col {
      grid-column: 1 / span 4;
    }
    .image-with-text__grid--reverse .image-with-text__media-col {
      order: 2;
    }
    .image-with-text__grid--reverse .image-with-text__content-col {
      order: 1;
    }
  }
  .image-with-text__media-frame {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-bg-subtle);
    aspect-ratio: 5 / 4;
  }
  .image-with-text__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .image-with-text__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .image-with-text__svg {
    width: 100%;
    height: 100%;
  }
  .image-with-text__content-col {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .image-with-text__content {
    max-width: 520px;
  }
  .image-with-text__title {
    font-size: var(--font-size-editorial);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }
  .image-with-text__text {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    line-height: var(--line-height-body);
    margin-bottom: var(--space-6);
  }
  .image-with-text__action {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
</style>

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "class": "section-image-with-text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop image placement",
      "options": [
        {
          "value": "image_first",
          "label": "Image first"
        },
        {
          "value": "text_first",
          "label": "Text first"
        }
      ],
      "default": "image_first"
    },
    {
      "type": "checkbox",
      "id": "subtle_bg",
      "label": "Use subtle surface background",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow subheading",
      "default": "Botanical Sourcing"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Whole-Plant Potency Preserved at Harvest"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description text",
      "default": "<p>Every formulation begins with wildcrafted botanicals, cold-pressed within hours of harvest to preserve delicate enzymatic co-factors and active phytonutrients for cellular radiance.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Our Philosophy"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Destination page or collection URL. If left empty, the button is hidden."
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}

