{%- comment -%}
  Vespera Theme - Image With Text Section
  Editorial split storytelling section with reversible layout and botanical aesthetic.
{%- endcomment -%}

<div class="image-with-text section-spacing {% if section.settings.subtle_bg %}image-with-text--subtle-bg{% endif %}" id="ImageWithText-{{ section.id }}">
  <div class="page-container">
    <div class="image-with-text__grid {% if section.settings.layout == 'text_first' %}image-with-text__grid--reverse{% endif %}">
      
      <!-- Media Column -->
      <div class="image-with-text__media-col">
        <div class="image-with-text__media-frame">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1200 | image_tag:
               loading: 'lazy',
               class: 'image-with-text__img',
               alt: section.settings.image.alt | default: section.settings.heading | escape
            }}
          {%- else -%}
            <img 
              src="{{ 'botanical-extraction.jpg' | asset_url }}" 
              alt="{{ section.settings.heading | default: 'Botanical Extraction Process' | escape }}"
              class="image-with-text__img"
              loading="lazy"
              width="1200"
              height="1500"
            >
          {%- endif -%}
        </div>
      </div>

      <!-- Content Column -->
      <div class="image-with-text__content-col">
        <div class="image-with-text__content">
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="image-with-text__title font-heading">
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <div class="image-with-text__text rte">
              {{ section.settings.text }}
            </div>
          {%- endif -%}

          {%- if section.settings.button_label != blank -%}
            <div class="image-with-text__action">
              <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="btn-primary">
                {{ section.settings.button_label | escape }}
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  .image-with-text--subtle-bg {
    background-color: var(--color-surface);
  }
  .image-with-text__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }
  @media (min-width: 990px) {
    .image-with-text__grid {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-12);
    }
    .image-with-text__grid--reverse .image-with-text__media-col {
      order: 2;
    }
    .image-with-text__grid--reverse .image-with-text__content-col {
      order: 1;
    }
  }
  .image-with-text__media-frame {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-bg-subtle);
    aspect-ratio: 4 / 4.8;
  }
  .image-with-text__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .image-with-text__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .image-with-text__svg {
    width: 100%;
    height: 100%;
  }
  .image-with-text__content {
    max-width: 520px;
  }
  .image-with-text__title {
    font-size: clamp(1.85rem, 3.2vw, 2.75rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }
  .image-with-text__text {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-6);
  }
  .image-with-text__action {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
</style>

{% schema %}
{
  "name": "Image with Text",
  "tag": "section",
  "class": "section-image-with-text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop image placement",
      "options": [
        {
          "value": "image_first",
          "label": "Image first"
        },
        {
          "value": "text_first",
          "label": "Text first"
        }
      ],
      "default": "image_first"
    },
    {
      "type": "checkbox",
      "id": "subtle_bg",
      "label": "Use subtle surface background",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow subheading",
      "default": "Clinical Extraction"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Whole-Plant Potency Preserved at Harvest"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description text",
      "default": "<p>Every formulation begins with wildcrafted botanicals, cold-pressed within hours of harvest to preserve delicate enzymatic co-factors and active phytonutrients for cellular radiance.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Our Philosophy"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Image with Text"
    }
  ]
}
{% endschema %}

