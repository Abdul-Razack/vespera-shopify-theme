{%- comment -%}
  Vespera Theme - Main Password Section (Online Store 2.0)
  Minimalist editorial landing page for private boutique preview and password entry.
{%- endcomment -%}

<div class="password-page text-center">
  <div class="password-page__container">
    <header class="password-page__header">
      <h1 class="password-page__shop-name">{{ shop.name | escape }}</h1>
      <h2 class="password-page__title">{{ section.settings.title | escape }}</h2>
      {%- if shop.password_message != blank -%}
        <div class="password-page__message rte">
          {{ shop.password_message }}
        </div>
      {%- elsif section.settings.subtitle != blank -%}
        <p class="password-page__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </header>

    <div class="password-page__content">
      <div class="password-page__login">
        {%- form 'storefront_password', class: 'password-form' -%}
          {%- if form.errors -%}
            <div class="form-message form-message--error" tabindex="-1" autofocus>
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="password-form__input-group">
            <label for="PasswordForm-password" class="password-form__label">
              {{ 'password.password' | t }}
            </label>
            <input 
              type="password" 
              name="password" 
              id="PasswordForm-password" 
              class="form-control text-center" 
              placeholder="{{ 'password.password' | t }}"
              autocomplete="current-password"
              required
              aria-required="true"
            >
            <button type="submit" class="btn btn-primary" style="margin-top: var(--space-4); width: 100%;">
              {{ 'password.enter' | t }}
            </button>
          </div>
        {%- endform -%}
      </div>
    </div>

    <footer class="password-page__footer">
      <p class="password-page__admin-link" style="color: var(--color-text);">
        {{ 'password.store_owner_html' | t }} 
        <a href="/admin" class="link-underline" style="color: var(--color-accent); font-weight: 600;" aria-label="{{ 'password.log_in_here' | t }} - Store admin login">{{ 'password.log_in_here' | t }}</a>
      </p>
    </footer>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "class": "section-main-password",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Opening soon"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "We are preparing our seasonal botanical release. Enter the boutique password to preview."
    }
  ]
}
{% endschema %}

