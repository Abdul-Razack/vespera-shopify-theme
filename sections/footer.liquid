<footer class="site-footer" role="contentinfo">
  <div class="page-container">
    
    <!-- Top Grid: Brand Bio + Newsletter + Menus -->
    <div class="site-footer__grid">
      
      <!-- Column 1: Brand Philosophy -->
      <div class="site-footer__col site-footer__col--brand">
        <h2 class="site-footer__brand-title">{{ shop.name }}</h2>
        <p class="site-footer__brand-desc">
          Formulated with intentional botanical extracts and clinical precision. Created for conscious rituals and radiant skin.
        </p>

        <!-- Social Media Links (Quiet Luxury Monochrome SVGs) -->
        {%- if section.settings.show_social_icons -%}
          <div class="site-footer__social-list">
            {%- if settings.social_instagram_link != blank -%}
              <a href="{{ settings.social_instagram_link }}" class="site-footer__social-link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </a>
            {%- endif -%}

            {%- if settings.social_tiktok_link != blank -%}
              <a href="{{ settings.social_tiktok_link }}" class="site-footer__social-link" aria-label="TikTok" target="_blank" rel="noopener noreferrer">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
                </svg>
              </a>
            {%- endif -%}

            {%- if settings.social_pinterest_link != blank -%}
              <a href="{{ settings.social_pinterest_link }}" class="site-footer__social-link" aria-label="Pinterest" target="_blank" rel="noopener noreferrer">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="12" y1="9" x2="12" y2="21"></line>
                  <path d="M8 12a4 4 0 1 1 8 0c0 3-2 5-4 5s-2-2-2-3"></path>
                </svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Column 2: Quick Links -->
      <div class="site-footer__col site-footer__col--links">
        <h3 class="site-footer__heading">Explore</h3>
        <ul class="site-footer__link-list">
          {%- if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 -%}
            {%- for link in linklists[section.settings.menu].links -%}
              <li><a href="{{ link.url }}" class="site-footer__link">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="{{ routes.all_products_collection_url }}" class="site-footer__link">All Formulations</a></li>
            <li><a href="{{ routes.collections_url }}" class="site-footer__link">Ritual Sets</a></li>
            <li><a href="{{ routes.search_url }}" class="site-footer__link">Search Catalog</a></li>
            <li><a href="/pages/contact" class="site-footer__link">Customer Care</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Column 3: Newsletter (High-Converting & Accessible) -->
      <div class="site-footer__col site-footer__col--newsletter">
        <h3 class="site-footer__heading">{{ section.settings.newsletter_heading | default: 'The Inner Circle' }}</h3>
        <p class="site-footer__newsletter-text">
          {{ section.settings.newsletter_subheading | default: 'Receive private invitations and early formula releases.' }}
        </p>

        {%- form 'customer', id: 'ContactFooter', class: 'site-footer__newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          
          {%- if form.posted_successfully? -%}
            <div class="site-footer__form-success" role="status" tabindex="-1" autofocus>
              <span class="site-footer__success-icon" aria-hidden="true">&check;</span>
              <div>
                <strong>Welcome to The Aura Circle.</strong>
                <p class="site-footer__success-text">Your private invitation and formula access details have been dispatched to your inbox.</p>
              </div>
            </div>
          {%- else -%}
            {%- if form.errors -%}
              <p class="site-footer__form-error" role="alert">
                {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
              </p>
            {%- endif -%}

            <div class="site-footer__input-group">
              <label for="NewsletterEmail" class="visually-hidden">Email address</label>
              <input 
                id="NewsletterEmail"
                type="email" 
                name="contact[email]" 
                class="site-footer__input" 
                value="{{ form.email }}" 
                placeholder="Enter your email" 
                aria-required="true" 
                autocorrect="off" 
                autocapitalize="off" 
                autocomplete="email"
                {% if form.errors %}aria-invalid="true"{% endif %}
                required
              >
              <button type="submit" class="site-footer__submit-btn" aria-label="Join - Subscribe to newsletter">
                Join &rarr;
              </button>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>

    </div>

    <!-- Bottom Bar: Copyright, Compliance & Payment Badges -->
    <div class="site-footer__bottom">
      <div class="site-footer__bottom-left">
        <p class="site-footer__copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved. Powered by Shopify.
        </p>

        <!-- Mandatory E-Commerce Legal Compliance Policies -->
        {%- if shop.policies.size > 0 -%}
          <ul class="site-footer__policies-list" role="list" aria-label="Legal Policies">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li class="site-footer__policy-item">
                  <a href="{{ policy.url }}" class="site-footer__policy-link">{{ policy.title }}</a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- else -%}
          <ul class="site-footer__policies-list" role="list" aria-label="Legal Policies">
            <li class="site-footer__policy-item"><a href="/policies/privacy-policy" class="site-footer__policy-link">Privacy Policy</a></li>
            <li class="site-footer__policy-item"><a href="/policies/terms-of-service" class="site-footer__policy-link">Terms of Service</a></li>
            <li class="site-footer__policy-item"><a href="/policies/refund-policy" class="site-footer__policy-link">Refund Policy</a></li>
            <li class="site-footer__policy-item"><a href="/policies/shipping-policy" class="site-footer__policy-link">Shipping Policy</a></li>
          </ul>
        {%- endif -%}
      </div>

      <!-- Shopify Markets Country/Currency & Language Selectors -->
      <div class="site-footer__localization">
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
            <div class="localization-selector">
              <label for="FooterCountrySelect" class="visually-hidden">Country / Currency</label>
              <select name="country_code" id="FooterCountrySelect" class="localization-selector__select" onchange="this.form.submit()">
                {%- for country in localization.available_countries -%}
                  <option 
                    value="{{ country.iso_code }}" 
                    {% if country.iso_code == localization.country.iso_code %}selected="selected"{% endif %}
                  >
                    {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                  </option>
                {%- endfor -%}
              </select>
              <span class="localization-selector__arrow" aria-hidden="true">&darr;</span>
            </div>
          {%- endform -%}
        {%- endif -%}

        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
            <div class="localization-selector">
              <label for="FooterLanguageSelect" class="visually-hidden">Language</label>
              <select name="locale_code" id="FooterLanguageSelect" class="localization-selector__select" onchange="this.form.submit()">
                {%- for language in localization.available_languages -%}
                  <option 
                    value="{{ language.iso_code }}" 
                    {% if language.iso_code == localization.language.iso_code %}selected="selected"{% endif %}
                  >
                    {{ language.endonym_name | capitalize }}
                  </option>
                {%- endfor -%}
              </select>
              <span class="localization-selector__arrow" aria-hidden="true">&darr;</span>
            </div>
          {%- endform -%}
        {%- endif -%}
      </div>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types != empty -%}
        <div class="site-footer__payments" aria-label="Payment methods">
          <ul class="site-footer__payment-list" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li class="site-footer__payment-item">
                {{ type | payment_type_svg_tag: class: 'payment-icon' }}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>

  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-bg-subtle);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-12);
    padding-bottom: var(--space-8);
    color: var(--color-text);
  }
  @media (min-width: 768px) {
    .site-footer {
      padding-top: var(--section-padding-desktop);
      padding-bottom: var(--space-12);
    }
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    margin-bottom: var(--space-16);
  }
  @media (min-width: 768px) {
    .site-footer__grid {
      grid-template-columns: 1.5fr 1fr 1.5fr;
      gap: var(--space-12);
    }
  }
  .site-footer__brand-title {
    font-family: var(--font-serif);
    font-size: var(--font-size-lg);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }
  .site-footer__brand-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    max-width: 320px;
    line-height: 1.7;
  }
  .site-footer__heading {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }
  .site-footer__link-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .site-footer__link {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }
  .site-footer__link:hover {
    color: var(--color-text);
  }
  .site-footer__newsletter-text {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }
  .site-footer__input-group {
    display: flex;
    border-bottom: 1px solid var(--color-border-dark);
    max-width: 360px;
  }
  .site-footer__input {
    flex: 1;
    background: transparent;
    border: none;
    padding: var(--space-3) 0;
    font-size: var(--font-size-sm);
    color: var(--color-text);
    outline: none;
  }
  .site-footer__submit-btn {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    padding: var(--space-3) var(--space-2);
    transition: color var(--transition-fast);
  }
  .site-footer__submit-btn:hover {
    color: var(--color-accent);
  }
  .site-footer__social-list {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }
  .site-footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }
  .site-footer__social-link:hover {
    color: var(--color-text);
    transform: translateY(-2px);
  }
  .site-footer__localization {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  .localization-selector {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .localization-selector__select {
    appearance: none;
    -webkit-appearance: none;
    background-color: var(--color-surface, #FFFFFF);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-6) var(--space-2) var(--space-3);
    font-size: var(--font-size-xs);
    color: var(--color-text);
    cursor: pointer;
    font-family: inherit;
    line-height: 1.4;
  }
  .localization-selector__arrow {
    position: absolute;
    right: 8px;
    font-size: 10px;
    color: var(--color-text-muted);
    pointer-events: none;
  }
  .site-footer__form-success {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background-color: rgba(46, 125, 50, 0.08);
    border: 1px solid rgba(46, 125, 50, 0.25);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-sm);
    color: var(--color-text);
    margin-bottom: var(--space-4);
    line-height: 1.5;
  }
  .site-footer__success-icon {
    color: #2e7d32;
    font-weight: bold;
    font-size: var(--font-size-base);
    line-height: 1.2;
  }
  .site-footer__success-text {
    margin-top: 4px;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }
  .site-footer__form-error {
    font-size: var(--font-size-xs);
    color: #d32f2f;
    margin-bottom: var(--space-3);
  }
  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-8);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }
  @media (min-width: 768px) {
    .site-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }
  .site-footer__bottom-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .site-footer__policies-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-footer__policy-link {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .site-footer__policy-link:hover {
    color: var(--color-text);
    text-decoration: underline;
  }
  .site-footer__payment-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }
  .payment-icon {
    width: 36px;
    height: 24px;
  }
  .visually-hidden {
    position: absolute !important;
    overflow: hidden;
    clip: rect(0 0 0 0);
    height: 1px;
    width: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
  }
</style>

<script>
  (function() {
    const footerForm = document.getElementById('ContactFooter');
    if (!footerForm) return;

    footerForm.addEventListener('submit', async function(e) {
      if (window.Shopify && window.Shopify.designMode) return;

      const submitBtn = footerForm.querySelector('.site-footer__submit-btn');
      const emailInput = footerForm.querySelector('#NewsletterEmail');
      if (!emailInput || !emailInput.value) return;

      e.preventDefault();
      const originalBtnText = submitBtn ? submitBtn.innerHTML : 'Join &rarr;';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = 'Subscribing...';
      }

      try {
        const formData = new FormData(footerForm);
        const response = await fetch(footerForm.action || '/contact#ContactFooter', {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'text/html'
          }
        });

        if (response.url && response.url.includes('/challenge')) {
          footerForm.submit();
          return;
        }

        const htmlText = await response.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(htmlText, 'text/html');
        const successMsg = doc.querySelector('.site-footer__form-success');
        const errorMsg = doc.querySelector('.site-footer__form-error');

        if (successMsg) {
          footerForm.innerHTML = successMsg.outerHTML;
        } else if (errorMsg) {
          let currentErr = footerForm.querySelector('.site-footer__form-error');
          if (!currentErr) {
            currentErr = document.createElement('p');
            currentErr.className = 'site-footer__form-error';
            footerForm.prepend(currentErr);
          }
          currentErr.textContent = errorMsg.textContent;
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnText;
          }
        } else {
          footerForm.submit();
        }
      } catch (err) {
        footerForm.submit();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "The Inner Circle"
    },
    {
      "type": "textarea",
      "id": "newsletter_subheading",
      "label": "Newsletter Subheading",
      "default": "Receive private invitations and early formula releases."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Quick Links Menu"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show Payment Icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social_icons",
      "label": "Show Social Media Icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Enable Country / Currency Selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "Enable Language Selector",
      "default": true
    }
  ]
}
{% endschema %}

