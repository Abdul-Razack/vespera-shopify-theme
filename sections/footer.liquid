{%- comment -%}
  Vespera Theme - Main Footer Component (Online Store 2.0)
  Complies with Shopify Theme Store: Section 4, 8, 12, 13, 14.
  Features: Follow on Shop button (F-16), 24x24px touch targets (F-41),
  localized policies without broken hardcoded paths (F-24).
{%- endcomment -%}

<footer class="site-footer" role="contentinfo">
  <div class="page-container">
    
    <!-- Top Grid: Brand Bio + Newsletter + Menus -->
    <div class="site-footer__grid">
      
      <!-- Column 1: Brand Philosophy -->
      <div class="site-footer__col site-footer__col--brand">
        <h2 class="site-footer__brand-title">{{ shop.name }}</h2>
        <p class="site-footer__brand-desc">
          Formulated with intentional botanical extracts and clinical precision. Created for conscious rituals and radiant skin.
        </p>

        <!-- Follow on Shop (Shopify Theme Store Requirement - F-16) -->
        {%- if shop.features.follow_on_shop? -%}
          <div class="site-footer__follow-on-shop" style="margin: var(--space-4) 0;">
            {{ shop | login_button: action: 'follow' }}
          </div>
        {%- endif -%}

        <!-- Social Media Links (Quiet Luxury Monochrome SVGs, min 24x24px touch target) -->
        {%- if section.settings.show_social_icons -%}
          <div class="site-footer__social-list">
            {%- if settings.social_instagram_link != blank -%}
              <a href="{{ settings.social_instagram_link }}" class="site-footer__social-link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </a>
            {%- endif -%}

            {%- if settings.social_tiktok_link != blank -%}
              <a href="{{ settings.social_tiktok_link }}" class="site-footer__social-link" aria-label="TikTok" target="_blank" rel="noopener noreferrer">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
                </svg>
              </a>
            {%- endif -%}

            {%- if settings.social_pinterest_link != blank -%}
              <a href="{{ settings.social_pinterest_link }}" class="site-footer__social-link" aria-label="Pinterest" target="_blank" rel="noopener noreferrer">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="12" y1="9" x2="12" y2="21"></line>
                  <path d="M8 12a4 4 0 1 1 8 0c0 3-2 5-4 5s-2-2-2-3"></path>
                </svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Column 2: Quick Links -->
      <div class="site-footer__col site-footer__col--links">
        <h3 class="site-footer__heading">{{ 'general.footer.explore' | t }}</h3>
        <ul class="site-footer__link-list">
          {%- if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 -%}
            {%- for link in linklists[section.settings.menu].links -%}
              <li><a href="{{ link.url }}" class="site-footer__link">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="{{ routes.all_products_collection_url }}" class="site-footer__link">{{ 'sections.footer.all_products' | t }}</a></li>
            <li><a href="{{ routes.collections_url }}" class="site-footer__link">{{ 'sections.footer.collections' | t }}</a></li>
            <li><a href="{{ routes.search_url }}" class="site-footer__link">{{ 'sections.footer.search' | t }}</a></li>
            <li><a href="{{ pages['contact'].url | default: routes.root_url }}" class="site-footer__link">{{ 'sections.footer.customer_care' | t }}</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Column 3: Newsletter -->
      <div class="site-footer__col site-footer__col--newsletter">
        <h3 class="site-footer__heading">{{ section.settings.newsletter_heading | escape }}</h3>
        <p class="site-footer__newsletter-text">
          {{ section.settings.newsletter_subheading | escape }}
        </p>

        {%- form 'customer', id: 'ContactFooter', class: 'site-footer__newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          
          {%- if form.posted_successfully? -%}
            <div class="site-footer__form-success" role="status" tabindex="-1" autofocus>
              <span class="site-footer__success-icon" aria-hidden="true">&check;</span>
              <div>
                <strong>{{ 'newsletter.success_title' | t }}</strong>
                <p class="site-footer__success-text">{{ 'newsletter.success_text' | t }}</p>
              </div>
            </div>
          {%- else -%}
            {%- if form.errors -%}
              <p class="site-footer__form-error" role="alert">
                {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
              </p>
            {%- endif -%}

            <div class="site-footer__input-group">
              <label for="NewsletterEmail" class="visually-hidden">{{ 'newsletter.email_placeholder' | t }}</label>
              <input 
                id="NewsletterEmail"
                type="email" 
                name="contact[email]" 
                class="site-footer__input" 
                value="{{ form.email }}" 
                placeholder="{{ 'newsletter.email_placeholder' | t }}" 
                aria-required="true" 
                autocorrect="off" 
                autocapitalize="off" 
                autocomplete="email"
                {% if form.errors %}aria-invalid="true"{% endif %}
                required
              >
              <button type="submit" class="site-footer__submit-btn" aria-label="{{ 'newsletter.button_label' | t }} - Subscribe to newsletter">
                {{ 'newsletter.button_label' | t }} &rarr;
              </button>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="site-footer__bottom">
      
      <!-- Upper Utility Row: Country/Currency Selector & Payment Badges -->
      <div class="site-footer__bottom-row site-footer__bottom-row--utilities">
        <div class="site-footer__localization">
          {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
            {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
              <div class="localization-selector">
                <label for="FooterCountrySelect" class="visually-hidden">{{ 'localization.country_label' | t }}</label>
                <select name="country_code" id="FooterCountrySelect" class="localization-selector__select" onchange="this.form.submit()">
                  {%- for country in localization.available_countries -%}
                    <option 
                      value="{{ country.iso_code }}" 
                      {% if country.iso_code == localization.country.iso_code %}selected="selected"{% endif %}
                    >
                      {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                    </option>
                  {%- endfor -%}
                </select>
                <svg class="localization-selector__icon" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M1 1L5 5L9 1"></path>
                </svg>
              </div>
            {%- endform -%}
          {%- endif -%}

          {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
            {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
              <div class="localization-selector">
                <label for="FooterLanguageSelect" class="visually-hidden">{{ 'localization.language_label' | t }}</label>
                <select name="locale_code" id="FooterLanguageSelect" class="localization-selector__select" onchange="this.form.submit()">
                  {%- for language in localization.available_languages -%}
                    <option 
                      value="{{ language.iso_code }}" 
                      {% if language.iso_code == localization.language.iso_code %}selected="selected"{% endif %}
                    >
                      {{ language.endonym_name | capitalize }}
                    </option>
                  {%- endfor -%}
                </select>
                <svg class="localization-selector__icon" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M1 1L5 5L9 1"></path>
                </svg>
              </div>
            {%- endform -%}
          {%- endif -%}
        </div>

        <!-- Payment Methods -->
        {%- if section.settings.show_payment_icons and shop.enabled_payment_types != empty -%}
          <div class="site-footer__payments" aria-label="Payment methods">
            <ul class="site-footer__payment-list" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li class="site-footer__payment-item">
                  {{ type | payment_type_svg_tag: class: 'payment-icon' }}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>

      <!-- Lower Legal Row: Policies & Copyright (F-24) -->
      <div class="site-footer__bottom-row site-footer__bottom-row--legal">
        <ul class="site-footer__policies-list" role="list" aria-label="Legal Policies">
          {%- if shop.policies.size > 0 -%}
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li class="site-footer__policy-item">
                  <a href="{{ policy.url }}" class="site-footer__policy-link">{{ policy.title }}</a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- if shop.privacy_policy -%}
              <li class="site-footer__policy-item"><a href="{{ shop.privacy_policy.url }}" class="site-footer__policy-link">{{ 'general.footer.privacy_policy' | t }}</a></li>
            {%- endif -%}
            {%- if shop.terms_of_service -%}
              <li class="site-footer__policy-item"><a href="{{ shop.terms_of_service.url }}" class="site-footer__policy-link">{{ 'general.footer.terms_of_service' | t }}</a></li>
            {%- endif -%}
            {%- if shop.shipping_policy -%}
              <li class="site-footer__policy-item"><a href="{{ shop.shipping_policy.url }}" class="site-footer__policy-link">{{ 'general.footer.shipping_policy' | t }}</a></li>
            {%- endif -%}
          {%- endif -%}
        </ul>

        <div class="site-footer__copyright">
          <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
          <span class="site-footer__powered">{{ powered_by_link }}</span>
        </div>
      </div>

    </div>

  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-16);
    padding-bottom: var(--space-8);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    margin-bottom: var(--space-16);
  }
  @media (min-width: 768px) {
    .site-footer__grid {
      grid-template-columns: 1.5fr 1fr 1.5fr;
      gap: var(--space-8);
    }
  }
  .site-footer__brand-title {
    font-family: var(--font-serif);
    font-size: var(--font-size-lg);
    color: var(--color-text);
    margin-bottom: var(--space-4);
    letter-spacing: 0.05em;
  }
  .site-footer__brand-desc {
    line-height: 1.6;
    margin-bottom: var(--space-6);
    max-width: 320px;
  }
  .site-footer__social-list {
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }
  .site-footer__social-link {
    color: var(--color-text);
    min-width: 24px;
    min-height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color var(--transition-fast);
  }
  .site-footer__social-link:hover {
    color: var(--color-accent);
  }
  .site-footer__heading {
    font-size: var(--font-size-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: var(--space-4);
    font-weight: var(--font-weight-medium);
  }
  .site-footer__link-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .site-footer__link {
    color: var(--color-text-muted);
    min-height: 24px;
    display: inline-flex;
    align-items: center;
    transition: color var(--transition-fast);
  }
  .site-footer__link:hover {
    color: var(--color-text);
  }
  .site-footer__newsletter-text {
    line-height: 1.5;
    margin-bottom: var(--space-4);
  }
  .site-footer__input-group {
    display: flex;
    border-bottom: 1px solid var(--color-text);
    padding-bottom: var(--space-2);
  }
  .site-footer__input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: var(--font-size-sm);
    color: var(--color-text);
    outline: none;
    min-height: 44px;
  }
  .site-footer__submit-btn {
    background: transparent;
    border: none;
    color: var(--color-text);
    font-size: var(--font-size-sm);
    cursor: pointer;
    padding: 0 var(--space-2);
    min-height: 44px;
  }
  .site-footer__form-success {
    display: flex;
    gap: var(--space-3);
    color: var(--color-text);
    font-size: var(--font-size-xs);
  }
  .site-footer__bottom {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-8);
  }
  .site-footer__bottom-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  @media (min-width: 768px) {
    .site-footer__bottom-row {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
  .site-footer__policies-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .site-footer__policy-link {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    min-height: 24px;
    display: inline-flex;
    align-items: center;
  }
  .site-footer__copyright {
    font-size: var(--font-size-xs);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .site-footer__payment-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }
  .localization-selector__select {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg);
    color: var(--color-text);
    padding: var(--space-2) var(--space-4);
    font-size: var(--font-size-xs);
    min-height: 40px;
  }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "The Inner Circle"
    },
    {
      "type": "textarea",
      "id": "newsletter_subheading",
      "label": "Newsletter subheading",
      "default": "Receive private invitations and early formula releases."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Quick links menu"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social_icons",
      "label": "Show social media icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Enable country and currency selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "Enable language selector",
      "default": true
    }
  ]
}
{% endschema %}
