<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background | default: '#FAF8F5' }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    {%- endif -%}

    {%- capture seo_title -%}
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    {%- endcapture -%}
    <title>{{ seo_title }}</title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- if settings.type_body_font != blank and settings.type_body_font.system? == false -%}
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', type: 'font/woff2' }}
    {%- endif -%}
    {%- if settings.type_header_font != blank and settings.type_header_font.system? == false -%}
      {{ settings.type_header_font | font_url | preload_tag: as: 'font', type: 'font/woff2' }}
    {%- endif -%}

    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.theme = window.theme || {};
      window.theme.routes = {
        root: '{{ routes.root_url }}',
        cart: '{{ routes.cart_url }}',
        cartAdd: '{{ routes.cart_add_url }}',
        cartChange: '{{ routes.cart_change_url }}',
        cartUpdate: '{{ routes.cart_update_url }}',
        predictiveSearch: '{{ routes.predictive_search_url }}',
        productRecommendations: '{{ routes.product_recommendations_url }}'
      };
      window.theme.strings = {
        addToCart: {{ 'products.product.add_to_cart' | t | default: 'Add to cart' | json }},
        soldOut: {{ 'products.product.sold_out' | t | default: 'Sold out' | json }},
        unavailable: {{ 'products.product.unavailable' | t | default: 'Unavailable' | json }},
        inStock: {{ 'products.product.in_stock' | t | default: 'In stock' | json }},
        backorder: {{ 'products.product.backorder_message' | t | default: 'Available on backorder' | json }},
        quickAdd: {{ 'products.product.quick_add' | t | default: 'Quick add' | json }},
        quickView: {{ 'products.product.quick_view' | t | default: 'Quick view' | json }},
        cartEmpty: {{ 'sections.cart.empty' | t | default: 'Your cart is empty' | json }}
      };
    </script>
  </head>

  <body class="template-{{ template.name | default: 'index' }}">
    <a class="skip-to-content-link" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t | default: 'Skip to content' }}
    </a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}
    {% render 'quick-view-modal' %}

    <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    <script>
      /* Shopify Theme Store Best Practice: Import Quick View on interaction */
      (function() {
        let qvLoaded = false;
        function loadQuickView(e) {
          if (qvLoaded) return;
          qvLoaded = true;
          const s = document.createElement('script');
          s.src = "{{ 'quick-view.js' | asset_url }}";
          s.onload = function() {
            if (e && e.type === 'click') {
              const t = e.target.closest('[data-quick-view-handle]');
              if (t) t.click();
            }
          };
          document.body.appendChild(s);
        }
        document.addEventListener('mouseover', function(e) {
          if (e.target.closest('[data-quick-view-handle]')) loadQuickView(e);
        }, { passive: true });
        document.addEventListener('touchstart', function(e) {
          if (e.target.closest('[data-quick-view-handle]')) loadQuickView(e);
        }, { passive: true });
        document.addEventListener('click', function(e) {
          if (e.target.closest('[data-quick-view-handle]')) loadQuickView(e);
        });
      })();
    </script>
    <script>
      // Shopify Theme Editor Integration (Shopify Section 14 - F-25)
      document.addEventListener('shopify:section:load', function(event) {
        const container = event.target;
        if (container.querySelector('product-variant-picker')) {
          const picker = container.querySelector('product-variant-picker');
          if (picker && typeof picker.init === 'function') picker.init();
        }
        const recSection = container.querySelector('.product-recommendations');
        if (recSection && recSection.dataset.url) {
          fetch(recSection.dataset.url)
            .then(res => res.text())
            .then(html => {
              const parser = new DOMParser();
              const doc = parser.parseFromString(html, 'text/html');
              const newRec = doc.querySelector('.product-recommendations');
              if (newRec) recSection.innerHTML = newRec.innerHTML;
            })
            .catch(() => {});
        }
      });
      document.addEventListener('shopify:section:select', function(event) {
        event.target.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
      document.addEventListener('shopify:block:select', function(event) {
        event.target.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    </script>
  </body>
</html>
