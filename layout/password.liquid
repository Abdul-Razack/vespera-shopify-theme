<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {%- assign brand_name = shop.name -%}
    {%- if brand_name contains 'aura-theme-dev' or brand_name contains 'myshopify' -%}
      {%- assign brand_name = 'Vespera Botanica' -%}
    {%- endif -%}
    <title>{{ brand_name }} &ndash; {{ 'password.title' | t | default: 'Opening Soon' }}</title>
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-to-content-link" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>
    <main id="MainContent" class="password-main" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
