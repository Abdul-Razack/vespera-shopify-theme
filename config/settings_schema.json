[
  {
    "name": "theme_info",
    "theme_name": "Aura",
    "theme_version": "2.0.0",
    "theme_author": "Aura Themes",
    "theme_documentation_url": "https://aurathemes.co/docs",
    "theme_support_url": "https://aurathemes.co/support"
  },
  {
    "name": "Logo & Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo Image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 5,
        "unit": "px",
        "label": "Custom Logo Width",
        "default": 130
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon Image",
        "info": "Will be scaled down to 32 x 32px"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background Color",
        "default": "#FAF8F5"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text Color",
        "default": "#191817"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent / Highlight Color",
        "default": "#8C5942"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border Line Color",
        "default": "#E8E4DD"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Headings"
      },
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Heading Font",
        "default": "playfair_display_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 100,
        "max": 150,
        "step": 5,
        "unit": "%",
        "label": "Heading Font Scale",
        "default": 100
      },
      {
        "type": "header",
        "content": "Body"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body Font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 100,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Body Font Scale",
        "default": 100
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram Link"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok Link"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest Link"
      }
    ]
  }
]
