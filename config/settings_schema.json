[
  {
    "name": "theme_info",
    "theme_name": "Vespera",
    "theme_version": "2.0.0",
    "theme_author": "Vespera Themes",
    "theme_documentation_url": "https://vesperatheme.com/docs",
    "theme_support_url": "https://vesperatheme.com/support"
  },
  {
    "name": "Logo and favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 5,
        "unit": "px",
        "label": "Custom logo width",
        "default": 130
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Will be scaled down to 32 x 32px"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background color",
        "default": "#FAF8F5"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text color",
        "default": "#191817"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent / highlight color",
        "default": "#8C5942"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border line color",
        "default": "#E8E4DD"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Headings"
      },
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Heading font",
        "default": "playfair_display_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 100,
        "max": 150,
        "step": 5,
        "unit": "%",
        "label": "Heading font scale",
        "default": 100
      },
      {
        "type": "header",
        "content": "Body"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 100,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Body font scale",
        "default": 100
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram link"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok link"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest link"
      }
    ]
  }
]
