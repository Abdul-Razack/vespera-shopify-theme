{%- comment -%}
  Vespera Theme - Customer Address Book
  Minimalist luxury interface for managing delivery locations.
{%- endcomment -%}

<div class="customer-addresses section-spacing" data-customer-addresses>
  <div class="page-container">
    
    <!-- Top Nav & Header -->
    <div class="customer-addresses__nav mb-4">
      <a href="{{ routes.account_url }}" class="customer-addresses__back-link">
        &larr; {{ 'customer.account.return' | t }}
      </a>
    </div>

    <div class="customer-addresses__header">
      <div>
        <span class="eyebrow">{{ 'customers.addresses.eyebrow' | t }}</span>
        <h1 class="customer-addresses__title font-heading">{{ 'customers.addresses.title' | t }}</h1>
      </div>

      <div>
        <button type="button" aria-expanded="false" aria-controls="AddAddress" class="btn-primary" id="AddAddressToggle">
          + {{ 'customers.addresses.add_new' | t }}
        </button>
      </div>
    </div>

    <!-- New Address Collapsible Form -->
    <div id="AddAddress" class="customer-addresses__form-card customer-addresses__form-card--hidden mb-8">
      <h2 class="customer-addresses__form-title font-heading" id="AddressNewHeading">
        {{ 'customers.addresses.add_new' | t }}
      </h2>

      {%- form 'customer_address', customer.new_address, aria-labelledBy: 'AddressNewHeading' -%}
        <div class="customer-addresses__form-grid">
          <div class="customer-addresses__field">
            <label for="AddressFirstNameNew" class="customer-addresses__label">{{ 'customers.addresses.first_name' | t }}</label>
            <input type="text" id="AddressFirstNameNew" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name" class="customer-addresses__input">
          </div>
          <div class="customer-addresses__field">
            <label for="AddressLastNameNew" class="customer-addresses__label">{{ 'customers.addresses.last_name' | t }}</label>
            <input type="text" id="AddressLastNameNew" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name" class="customer-addresses__input">
          </div>
        </div>

        <div class="customer-addresses__field">
          <label for="AddressCompanyNew" class="customer-addresses__label">{{ 'customers.addresses.company' | t }}</label>
          <input type="text" id="AddressCompanyNew" name="address[company]" value="{{ form.company }}" autocomplete="organization" class="customer-addresses__input">
        </div>

        <div class="customer-addresses__field">
          <label for="AddressAddress1New" class="customer-addresses__label">{{ 'customers.addresses.address1' | t }}</label>
          <input type="text" id="AddressAddress1New" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" required class="customer-addresses__input">
        </div>

        <div class="customer-addresses__field">
          <label for="AddressAddress2New" class="customer-addresses__label">{{ 'customers.addresses.address2' | t }}</label>
          <input type="text" id="AddressAddress2New" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2" class="customer-addresses__input">
        </div>

        <div class="customer-addresses__form-grid">
          <div class="customer-addresses__field">
            <label for="AddressCityNew" class="customer-addresses__label">{{ 'customers.addresses.city' | t }}</label>
            <input type="text" id="AddressCityNew" name="address[city]" value="{{ form.city }}" autocomplete="address-level2" required class="customer-addresses__input">
          </div>
          <div class="customer-addresses__field">
            <label for="AddressCountryNew" class="customer-addresses__label">{{ 'customers.addresses.country' | t }}</label>
            <select id="AddressCountryNew" name="address[country]" data-default="{{ form.country }}" autocomplete="country" class="customer-addresses__input">
              {{ all_country_option_tags }}
            </select>
          </div>
        </div>

        <div class="customer-addresses__form-grid">
          <div class="customer-addresses__field">
            <label for="AddressZipNew" class="customer-addresses__label">{{ 'customers.addresses.zip' | t }}</label>
            <input type="text" id="AddressZipNew" name="address[zip]" value="{{ form.zip }}" autocapitalize="characters" autocomplete="postal-code" class="customer-addresses__input">
          </div>
          <div class="customer-addresses__field">
            <label for="AddressPhoneNew" class="customer-addresses__label">{{ 'customers.addresses.phone' | t }}</label>
            <input type="tel" id="AddressPhoneNew" name="address[phone]" value="{{ form.phone }}" autocomplete="tel" class="customer-addresses__input">
          </div>
        </div>

        <div class="customer-addresses__checkbox-field">
          {{ form.set_as_default_checkbox }}
          <label for="address_default_address_new">{{ 'customers.addresses.set_default' | t }}</label>
        </div>

        <div class="customer-addresses__form-actions">
          <button type="submit" class="btn-primary">{{ 'customers.addresses.add_new' | t }}</button>
          <button type="reset" class="btn-secondary" id="CancelNewAddress">{{ 'customers.addresses.cancel' | t }}</button>
        </div>
      {%- endform -%}
    </div>

    <!-- Existing Addresses Cards Grid -->
    <div class="customer-addresses__cards-grid">
      {%- for address in customer.addresses -%}
        <div class="customer-addresses__card" data-address>
          {%- if address == customer.default_address -%}
            <span class="status-badge status-badge--primary mb-3">{{ 'customers.addresses.default' | t }}</span>
          {%- endif -%}

          <div class="customer-addresses__body">
            {{ address | format_address }}
          </div>

          <div class="customer-addresses__card-actions">
            <button
              type="button"
              class="btn-secondary btn-sm"
              id="EditFormButton_{{ address.id }}"
              aria-label="{{ 'customers.addresses.edit' | t }} {{ forloop.index }}"
              aria-controls="EditAddress_{{ address.id }}"
              aria-expanded="false"
              data-address-id="{{ address.id }}"
              onclick="document.getElementById('EditAddress_{{ address.id }}').classList.toggle('customer-addresses__form-card--hidden')"
            >
              {{ 'customers.addresses.edit' | t }}
            </button>

            <form
              method="post"
              action="{{ routes.account_addresses_url }}/{{ address.id }}"
              onsubmit="return confirm('{{ 'customers.addresses.delete_confirm' | t }}');"
              class="inline-block"
            >
              <input type="hidden" name="_method" value="delete">
              <button type="submit" class="btn-outline-danger btn-sm" aria-label="{{ 'customers.addresses.delete' | t }} {{ forloop.index }}">
                {{ 'customers.addresses.delete' | t }}
              </button>
            </form>
          </div>

          <!-- Collapsible Edit Form -->
          <div id="EditAddress_{{ address.id }}" class="customer-addresses__form-card customer-addresses__form-card--hidden mt-6">
            <h3 class="customer-addresses__form-title font-heading">
              {{ 'customers.addresses.edit' | t }}
            </h3>

            {%- form 'customer_address', address -%}
              <div class="customer-addresses__form-grid">
                <div class="customer-addresses__field">
                  <label for="AddressFirstName_{{ form.id }}" class="customer-addresses__label">{{ 'customers.addresses.first_name' | t }}</label>
                  <input type="text" id="AddressFirstName_{{ form.id }}" name="address[first_name]" value="{{ form.first_name }}" class="customer-addresses__input">
                </div>
                <div class="customer-addresses__field">
                  <label for="AddressLastName_{{ form.id }}" class="customer-addresses__label">{{ 'customers.addresses.last_name' | t }}</label>
                  <input type="text" id="AddressLastName_{{ form.id }}" name="address[last_name]" value="{{ form.last_name }}" class="customer-addresses__input">
                </div>
              </div>

              <div class="customer-addresses__field">
                <label for="AddressAddress1_{{ form.id }}" class="customer-addresses__label">{{ 'customers.addresses.address1' | t }}</label>
                <input type="text" id="AddressAddress1_{{ form.id }}" name="address[address1]" value="{{ form.address1 }}" required class="customer-addresses__input">
              </div>

              <div class="customer-addresses__form-grid">
                <div class="customer-addresses__field">
                  <label for="AddressCity_{{ form.id }}" class="customer-addresses__label">{{ 'customers.addresses.city' | t }}</label>
                  <input type="text" id="AddressCity_{{ form.id }}" name="address[city]" value="{{ form.city }}" required class="customer-addresses__input">
                </div>
                <div class="customer-addresses__field">
                  <label for="AddressCountry_{{ form.id }}" class="customer-addresses__label">{{ 'customers.addresses.country' | t }}</label>
                  <select id="AddressCountry_{{ form.id }}" name="address[country]" data-default="{{ form.country }}" class="customer-addresses__input">
                    {{ all_country_option_tags }}
                  </select>
                </div>
              </div>

              <div class="customer-addresses__form-grid">
                <div class="customer-addresses__field">
                  <label for="AddressZip_{{ form.id }}" class="customer-addresses__label">{{ 'customers.addresses.zip' | t }}</label>
                  <input type="text" id="AddressZip_{{ form.id }}" name="address[zip]" value="{{ form.zip }}" class="customer-addresses__input">
                </div>
                <div class="customer-addresses__field">
                  <label for="AddressPhone_{{ form.id }}" class="customer-addresses__label">{{ 'customers.addresses.phone' | t }}</label>
                  <input type="tel" id="AddressPhone_{{ form.id }}" name="address[phone]" value="{{ form.phone }}" class="customer-addresses__input">
                </div>
              </div>

              <div class="customer-addresses__checkbox-field">
                {{ form.set_as_default_checkbox }}
                <label for="address_default_address_{{ form.id }}">{{ 'customers.addresses.set_default' | t }}</label>
              </div>

              <div class="customer-addresses__form-actions">
                <button type="submit" class="btn-primary">{{ 'customers.addresses.update' | t }}</button>
                <button type="button" class="btn-secondary" onclick="document.getElementById('EditAddress_{{ address.id }}').classList.add('customer-addresses__form-card--hidden')">
                  {{ 'customers.addresses.cancel' | t }}
                </button>
              </div>
            {%- endform -%}
          </div>

        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

<style>
  .customer-addresses__back-link {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    font-weight: var(--font-weight-semibold);
  }
  .customer-addresses__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-6);
    margin-bottom: var(--space-8);
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .customer-addresses__title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--color-text);
    margin: var(--space-2) 0 0;
  }
  .customer-addresses__form-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    max-width: 640px;
  }
  .customer-addresses__form-card--hidden {
    display: none;
  }
  .customer-addresses__form-title {
    font-size: var(--font-size-lg);
    color: var(--color-text);
    margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-3);
  }
  .customer-addresses__form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  .customer-addresses__field {
    margin-bottom: var(--space-4);
  }
  .customer-addresses__label {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }
  .customer-addresses__input {
    width: 100%;
    height: 48px;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg);
    color: var(--color-text);
    font-size: 16px; /* iOS auto-zoom prevention */
    outline: none;
  }
  .customer-addresses__input:focus {
    border-color: var(--color-accent);
  }
  .customer-addresses__checkbox-field {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-4) 0 var(--space-6);
    font-size: var(--font-size-sm);
    color: var(--color-text);
  }
  .customer-addresses__form-actions {
    display: flex;
    gap: var(--space-3);
  }
  .customer-addresses__cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  @media (min-width: 768px) {
    .customer-addresses__cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .customer-addresses__cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .customer-addresses__card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
  }
  .customer-addresses__body {
    font-size: var(--font-size-sm);
    line-height: 1.5;
    color: var(--color-text);
    margin-bottom: var(--space-6);
    flex-grow: 1;
  }
  .customer-addresses__card-actions {
    display: flex;
    gap: var(--space-3);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
  }
  .btn-sm {
    padding: 8px 16px;
    font-size: 12px;
  }
  .btn-outline-danger {
    background: transparent;
    border: 1px solid #E5E7EB;
    color: var(--color-sale);
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: background-color var(--transition-fast);
  }
  .btn-outline-danger:hover {
    background-color: #FDF2F2;
  }
  .inline-block {
    display: inline-block;
  }
</style>

<script>
  (function() {
    const addToggle = document.getElementById('AddAddressToggle');
    const addCard = document.getElementById('AddAddress');
    const cancelBtn = document.getElementById('CancelNewAddress');

    if (addToggle && addCard) {
      addToggle.addEventListener('click', function() {
        const isHidden = addCard.classList.contains('customer-addresses__form-card--hidden');
        if (isHidden) {
          addCard.classList.remove('customer-addresses__form-card--hidden');
          addToggle.setAttribute('aria-expanded', 'true');
        } else {
          addCard.classList.add('customer-addresses__form-card--hidden');
          addToggle.setAttribute('aria-expanded', 'false');
        }
      });
    }

    if (cancelBtn && addCard && addToggle) {
      cancelBtn.addEventListener('click', function() {
        addCard.classList.add('customer-addresses__form-card--hidden');
        addToggle.setAttribute('aria-expanded', 'false');
      });
    }
  })();
</script>
