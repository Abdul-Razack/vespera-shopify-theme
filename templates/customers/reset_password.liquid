{%- comment -%}
  Vespera Theme - Reset Customer Password
{%- endcomment -%}

<div class="customer-auth section-spacing">
  <div class="page-container page-container--narrow">
    <div class="customer-auth__card">
      
      <div class="customer-auth__header text-center">
        <span class="eyebrow">Security</span>
        <h1 class="customer-auth__title font-heading">{{ 'customers.reset_password.title' | t }}</h1>
        <p class="customer-auth__subtext">{{ 'customers.reset_password.subtext' | t }}</p>
      </div>

      {%- form 'reset_customer_password', class: 'customer-auth__form' -%}
        {%- if form.errors -%}
          <div class="customer-auth__errors" tabindex="-1" autofocus role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="customer-auth__field">
          <label for="ResetPassword" class="customer-auth__label">{{ 'customers.reset_password.password' | t }}</label>
          <input
            type="password"
            name="customer[password]"
            id="ResetPassword"
            autocomplete="new-password"
            required
            class="customer-auth__input"
          >
        </div>

        <div class="customer-auth__field">
          <label for="ResetPasswordConfirmation" class="customer-auth__label">{{ 'customers.reset_password.password_confirm' | t }}</label>
          <input
            type="password"
            name="customer[password_confirmation]"
            id="ResetPasswordConfirmation"
            autocomplete="new-password"
            required
            class="customer-auth__input"
          >
        </div>

        <div class="customer-auth__actions">
          <button type="submit" class="btn-primary customer-auth__submit">
            {{ 'customers.reset_password.submit' | t }}
          </button>
        </div>
      {%- endform -%}

    </div>
  </div>
</div>
