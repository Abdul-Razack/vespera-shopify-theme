{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
  </head>

  <body class="template-gift-card">
    {%- assign brand_name = shop.name -%}
    {%- if brand_name contains 'aura-theme-dev' or brand_name contains 'myshopify' -%}
      {%- assign brand_name = 'Vespera Botanica' -%}
    {%- endif -%}
    <main class="gift-card page-container text-center section-spacing">
      <div class="gift-card__box" style="max-width: 500px; margin: 0 auto; background: var(--color-surface); padding: var(--space-8); border: 1px solid var(--color-border); border-radius: var(--radius-md);">
        <header class="gift-card__header">
          {%- if settings.logo -%}
            {{ settings.logo | image_url: width: 300 | image_tag: alt: brand_name, class: 'gift-card__logo' }}
          {%- else -%}
            <h2 class="gift-card__shop-title">{{ brand_name }}</h2>
          {%- endif -%}
          <h1 class="gift-card__balance" style="font-size: var(--font-size-2xl); margin: var(--space-4) 0;">{{ gift_card.balance | money }}</h1>
        </header>

        {%- if gift_card.enabled == false or gift_card.expired -%}
          <p class="gift-card__badge gift-card__badge--expired" style="color: var(--color-sale);">{{ 'gift_card.expired' | t }}</p>
        {%- endif -%}

        {%- if gift_card.expires_on -%}
          {%- assign expires_on = gift_card.expires_on | date: '%B %e, %Y' -%}
          <p class="gift-card__expires">
            {{ 'gift_card.expires_on' | t: expires_on: expires_on }}
          </p>
        {%- endif -%}

        <div class="gift-card__visual" style="margin: var(--space-6) 0;">
          <img
            src="{{ 'gift-card/card.svg' | shopify_asset_url }}"
            alt="{{ 'gift_card.card' | t }}"
            width="280"
            height="180"
            style="border-radius: var(--radius-sm);"
          >
        </div>

        <p class="gift-card__instruction">{{ 'gift_card.use_at_checkout' | t }}</p>
        
        <div class="gift-card__code-wrap" style="background: var(--color-bg-subtle); padding: var(--space-3); border-radius: var(--radius-sm); margin: var(--space-4) 0; font-family: monospace; font-size: var(--font-size-md); letter-spacing: 0.1em;">
          <input 
            type="text" 
            readonly 
            value="{{ gift_card.code | format_code }}" 
            class="gift-card__code-input text-center" 
            id="GiftCardCode"
            aria-label="{{ 'gift_cards.issued.gift_card_code' | t }}"
            style="border: none; background: transparent; width: 100%; font-family: inherit; font-size: inherit; text-align: center;"
          >
        </div>

        <!-- 120x120px QR Code Canvas (Shopify Requirement - F-20) -->
        <div class="gift-card__qr-wrap" style="display: flex; justify-content: center; margin: var(--space-6) 0;">
          <div id="QrCode" class="gift-card__qr-code" data-identifier="{{ gift_card.qr_identifier }}"></div>
        </div>

        {%- if gift_card.pass_url -%}
          <div class="gift-card__apple-wallet" style="margin: var(--space-4) 0;">
            <a href="{{ gift_card.pass_url }}">
              <img
                src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
                alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
                width="200"
                height="60"
              >
            </a>
          </div>
        {%- endif -%}

        <div class="gift-card__actions" style="margin-top: var(--space-6);">
          <a href="{{ shop.url }}" class="btn btn-primary" target="_blank" rel="noopener">
            {{ 'general.continue_shopping' | t }} &rarr;
          </a>
        </div>
      </div>
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        if (typeof QRCode !== 'undefined') {
          new QRCode(document.getElementById('QrCode'), {
            text: '{{ gift_card.qr_identifier }}',
            width: 120,
            height: 120
          });
        }
      });
    </script>
  </body>
</html>
